#!/usr/bin/env bash
# nord-wg-config: generate a plain WireGuard config from NordVPN credentials.
#
# Why not just run the NordVPN app: on macOS its NetworkExtension sits at the
# packet layer and silently drops traffic belonging to any *other* tunnel. With
# the app connected, NetBird's control plane stays healthy and the routing table
# is untouched, but every new TCP connection to the overlay times out. Tailscale
# tracks the identical bug against NordVPN in tailscale/tailscale#21248 (closed,
# no workaround). wg-quick instead drives wireguard-go through a plain utun with
# no NetworkExtension at all, so the two tunnels are arbitrated by the routing
# table: NetBird's /16 beats the 0.0.0.0/1 + 128.0.0.0/1 pair wg-quick installs
# for a full tunnel, and both work at once.
#
# Token: Nord Account -> Services -> NordVPN -> Manual setup -> generate a new
# token. Store it at ~/.secrets/nordvpn/token; it never belongs in this repo.
#
# Usage:
#   nord-wg-config                 # recommended server, config to stdout
#   nord-wg-config nl              # restrict to a country (ISO 3166-1 alpha-2)
#   nord-wg-config nl | sudo tee /etc/wireguard/nord0.conf >/dev/null
set -euo pipefail

TOKEN_FILE="${NORD_TOKEN_FILE:-$HOME/.secrets/nordvpn/token}"
API="https://api.nordvpn.com/v1"
country="${1:-}"

for bin in jq curl; do
  command -v "$bin" >/dev/null || { echo "need $bin on PATH" >&2; exit 1; }
done

[[ -r "$TOKEN_FILE" ]] || {
  echo "no token at $TOKEN_FILE" >&2
  echo "get one: Nord Account -> Services -> NordVPN -> Manual setup" >&2
  exit 1
}
token="$(tr -d '[:space:]' < "$TOKEN_FILE")"

# The API is Nord's supported path for custom connections. Reading the key out
# of a live `wg show nordlynx private-key` also works, but the app rotates that
# key and your config then dies silently, so prefer this.
privkey="$(curl -fsS -u "token:$token" "$API/users/services/credentials" | jq -r '.nordlynx_private_key')"
[[ -n "$privkey" && "$privkey" != "null" ]] || { echo "API returned no nordlynx_private_key (token wrong or expired?)" >&2; exit 1; }

url="$API/servers/recommendations?filters[servers_technologies][identifier]=wireguard_udp&limit=1"
if [[ -n "$country" ]]; then
  # The recommendations endpoint filters by numeric country id, not ISO code.
  cc="$(printf '%s' "$country" | tr '[:lower:]' '[:upper:]')"
  cid="$(curl -fsSg "$API/servers/countries" | jq -r --arg c "$cc" '.[] | select(.code == $c) | .id')"
  [[ -n "$cid" ]] || { echo "unknown country code: $country" >&2; exit 1; }
  url+="&filters[country_id]=$cid"
fi

# -g / --globoff: the filter syntax uses [] which curl would otherwise read as a
# glob range and refuse with "bad range in URL".
server_json="$(curl -fsSg "$url")"
host="$(jq -r '.[0].hostname' <<<"$server_json")"
station="$(jq -r '.[0].station' <<<"$server_json")"
pubkey="$(jq -r '
  .[0].technologies[]
  | select(.identifier == "wireguard_udp")
  | .metadata[] | select(.name == "public_key") | .value
' <<<"$server_json")"

[[ -n "$pubkey" && "$pubkey" != "null" ]] || { echo "could not read server public key" >&2; exit 1; }

# DNS note: deliberately 1.1.1.1 rather than Nord's resolver. Nord's internal DNS
# is only reachable inside the tunnel, so if the tunnel drops while this machine
# is parked and unattended, name resolution would break and take remote access
# with it. 1.1.1.1 resolves either way; queries still ride the tunnel when it is
# up. Resilience beats the marginal privacy gain on a machine you cannot touch.
cat <<EOF
# Generated by nord-wg-config on $(date -u +%Y-%m-%dT%H:%M:%SZ)
# Server: $host ($station)
[Interface]
PrivateKey = $privkey
Address = 10.5.0.2/32
DNS = 1.1.1.1
MTU = 1420

[Peer]
PublicKey = $pubkey
Endpoint = $station:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
EOF
