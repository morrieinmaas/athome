# Note: repo-root files (README.md, LICENSE, docs/, scripts/, .github/, …) live
# ABOVE the home/ source root (.chezmoiroot), so chezmoi never sees them — no
# need to ignore them here. Only target paths under ~ that have a source need
# gating, which is what the OS-conditional blocks below do.

{{- if ne .chezmoi.os "darwin" }}
Library/**
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/niri/**
.config/quickshell/**
.config/noctalia/**
.config/fastfetch/**
.config/greetd/**
.config/systemd/**
.config/autostart/**
.config/qt5ct/**
.config/qt6ct/**
{{- end }}

# grofe's config (the port of canopy's user.conf) is drafted here but not
# shipped yet: no machine runs grofe before alias day, and one that has a
# hand-made ~/.config/grofe would lose it. Removed at TA.1, the alias-day
# container test, which drops these two lines to install it.
.config/grofe
.config/grofe/**
