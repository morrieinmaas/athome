# ~/.zsh/exports.zsh — managed by chezmoi
# Sourced from ~/.zshrc after path.zsh.

# ─── Editor ──────────────────────────────────────────────────────────────────
export EDITOR=nvim
export VISUAL=nvim
export SUDO_EDITOR=nvim
export PAGER=less
export LESS='-FRXM'
export MANPAGER='nvim +Man!'

# ─── Locale ──────────────────────────────────────────────────────────────────
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

# ─── fzf ─────────────────────────────────────────────────────────────────────
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'

# ─── uv (Python toolchain) ───────────────────────────────────────────────────
# uv manages Python versions, venvs, deps, and tool installs. No mise needed
# for anything Python-related.
export UV_PYTHON_PREFERENCE=managed       # always prefer uv-installed Pythons
export UV_TOOL_BIN_DIR="$HOME/.local/bin" # `uv tool install` -> shims on PATH

# ─── Podman (Docker drop-in) ─────────────────────────────────────────────────
# The `docker` CLI is a shim to podman (dot_local/bin) — it needs no DOCKER_HOST.
# This is for docker-API clients that hit a socket directly: docker-compose
# (Compose v2 Go binary), SDKs, testcontainers, lazydocker.
{{ if eq .chezmoi.os "darwin" -}}
# Stable socket from `podman-mac-helper install` (run_once_10) — survives machine
# restarts, unlike podman 5.x's per-boot TMPDIR api socket.
export DOCKER_HOST="unix:///var/run/docker.sock"
{{- else -}}
export DOCKER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
{{- end }}

# testcontainers on rootless podman: Ryuk (its reaper sidecar) needs privileged
# socket access it doesn't reliably get rootless, so it hangs/fails — disable it
# (testcontainers' own shutdown hook still tears down containers). Point the
# socket override at the same path as DOCKER_HOST so spawned containers that
# bind-mount the docker socket get the right one. Harmless if you never use
# testcontainers — only its own SDKs read these.
export TESTCONTAINERS_RYUK_DISABLED=true
export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE="${DOCKER_HOST#unix://}"

# ─── History (in addition to OMZ history lib) ────────────────────────────────
export HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
export HISTSIZE=100000
export SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt SHARE_HISTORY

# ─── Misc QoL ────────────────────────────────────────────────────────────────
setopt AUTO_CD                     # cd by typing dir name
setopt EXTENDED_GLOB               # **/*.py etc.
setopt INTERACTIVE_COMMENTS        # # comments allowed in shell
setopt NO_BEEP

# ─── GitHub token for MCP / tooling (no secret on disk) ──────────────────────
# The GitHub MCP server (and some CLIs) read $GITHUB_PERSONAL_ACCESS_TOKEN. gh
# keeps the token in the OS keyring; we materialize it into the env at shell
# start. Guarded, so a machine without gh — or not logged in — gets an empty
# value, never an error.
#
# We resolve the token ONCE and fan it out to every name consumers expect:
#   • GITHUB_PERSONAL_ACCESS_TOKEN — GitHub MCP server
#   • GITHUB_TOKEN / GH_TOKEN      — gh, hub, most CLIs
#   • MISE_GITHUB_TOKEN            — mise's github backend (release/version
#     lookups). WITHOUT this, mise hits the anonymous 60-req/hr limit and
#     `mise install` fails to resolve tools (helm/ruff/shfmt …) with 403s.
# Materialized OFF the startup path: `gh auth token` (a keychain read) is ~34ms,
# and nothing needs the token until you actually run gh / an MCP server / `mise
# install` — all after the prompt. So set it on the SECOND precmd (right after the
# first prompt draws), once, then unhook. mise install at t=0 is non-interactive
# (chezmoi scripts) and unaffected; this is interactive-shell only.
if command -v gh >/dev/null 2>&1; then
  typeset -gi _ghtok_skip=1
  _ghtok_load() {
    (( _ghtok_skip )) && { _ghtok_skip=0; return; }   # skip the pre-first-prompt precmd
    add-zsh-hook -d precmd _ghtok_load
    local t; t="$(command gh auth token 2>/dev/null)"
    [[ -n "$t" ]] && export GITHUB_PERSONAL_ACCESS_TOKEN="$t" GITHUB_TOKEN="$t" MISE_GITHUB_TOKEN="$t"
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _ghtok_load
fi

# ─── SSH keys (no agent required) ────────────────────────────────────────────
# GPG / gpg-agent retired (Phase 5). The ed25519 identity keys are generated
# WITHOUT a passphrase (bootstrap.sh) and ~/.ssh/config pins them per-host via
# IdentityFile + IdentitiesOnly, so ssh and git (SSH commit signing) read the
# key files directly — no ssh-agent or gpg-agent needed. On macOS the keys are
# additionally added to the Keychain (UseKeychain in ~/.ssh/config); on Linux
# nothing to wire.
