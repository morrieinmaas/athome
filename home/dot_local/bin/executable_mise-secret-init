#!/usr/bin/env bash
# mise-secret-init [repo-dir] [name] — wire a repo into the mise + ~/.secrets secret pattern.
#
# Moves (or creates) the repo's .env to ~/.secrets/<name>/.env, writes a committed mise.toml
# with `_.file`, trusts it, verifies mise injects a var, removes the in-repo copy, and backs
# it up to Bitwarden. See docs/secrets.md → "Model B / onboarding a repo".
#
#   cd my-repo && mise-secret-init                # name defaults to repo basename
#   mise-secret-init ~/Code/foo/bar  bar          # explicit dir + name
set -uo pipefail
PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/nanobrew/prefix/bin:$PATH"

R="${1:-$PWD}"; R="$(cd "$R" && pwd)" || { echo "no such dir: $1"; exit 1; }
name="${2:-$(basename "$R")}"
cdir="$HOME/.secrets/$name"
mise="$(command -v mise || echo /opt/homebrew/bin/mise)"

echo "repo: $R"
echo "name: $name  →  $cdir/.env"

mkdir -p "$cdir" && chmod 700 "$HOME/.secrets" "$cdir"

if [ -f "$R/.env" ]; then
  cp "$R/.env" "$cdir/.env"
elif [ -f "$cdir/.env" ]; then
  echo "(using existing $cdir/.env)"
elif [ -f "$R/.env.example" ]; then
  cp "$R/.env.example" "$cdir/.env"; echo "seeded from .env.example — FILL IN VALUES, then re-run / edit"
else
  : > "$cdir/.env"; echo "created empty $cdir/.env — add your vars"
fi
chmod 600 "$cdir/.env"

# committed mise.toml (idempotent)
if [ ! -f "$R/mise.toml" ]; then
  printf '[env]\n_.file = "~/.secrets/%s/.env"\n' "$name" > "$R/mise.toml"
  echo "wrote $R/mise.toml"
elif ! grep -q '_\.file' "$R/mise.toml"; then
  printf '\n[env]\n_.file = "~/.secrets/%s/.env"\n' "$name" >> "$R/mise.toml"
  echo "appended [env] to existing $R/mise.toml"
fi

( cd "$R" && "$mise" trust >/dev/null 2>&1 )

# verify mise can parse + inject (first KEY)
key="$(sed -E 's/=.*//' "$cdir/.env" | grep -vE '^[[:space:]]*#|^[[:space:]]*$' | head -1)"
if [ -n "$key" ] && ( cd "$R" && "$mise" env 2>/dev/null | grep -qE "(^| )${key}=" ); then
  echo "✓ mise injects $key from $cdir/.env"
  # only now remove the in-repo copy + ensure gitignore
  ( cd "$R" && git check-ignore .env >/dev/null 2>&1 ) || echo ".env" >> "$R/.gitignore"
  [ -f "$R/.env" ] && rm "$R/.env" && echo "removed in-repo $R/.env"
  command -v secrets-backup >/dev/null 2>&1 && secrets-backup >/dev/null 2>&1 && echo "backed up to Bitwarden"
  echo "Done. Commit mise.toml (and .gitignore) when ready."
else
  echo "⚠ mise did NOT inject vars — check $cdir/.env parses as dotenv (no bare lines / unquoted spaces)."
  echo "  In-repo .env kept; mise.toml left in place. Fix the file, then re-run."
fi
