{{/* First-run prompts for chezmoi. Stored at ~/.config/chezmoi/chezmoi.toml after init. */ -}}

{{- $machineType         := promptStringOnce . "machineType"         "Machine type (work|personal — personal covers sidehustle)" "personal" -}}
{{- $hostname            := promptStringOnce . "hostname"            "Hostname" .chezmoi.hostname -}}
{{- $githubHandle        := promptStringOnce . "githubHandle"        "GitHub username (e.g. octocat)" "" -}}
{{- $githubId            := promptStringOnce . "githubId"            "GitHub numeric user ID (`gh api user -q .id`; empty = plain noreply email)" "" -}}
{{- $netbirdMgmtUrl      := promptStringOnce . "netbirdManagementUrl" "NetBird management URL (empty = NetBird Cloud SaaS, e.g. https://netbird.example.com when self-hosting)" "" -}}
{{- $nordvpnCountry      := promptStringOnce . "nordvpnCountry"      "NordVPN auto-connect country (empty = NordVPN picks best, e.g. Netherlands)" "" -}}
{{- $bitwardenUrl        := promptStringOnce . "bitwardenUrl"        "Bitwarden server URL (empty = US cloud bitwarden.com; EU = https://vault.bitwarden.eu; or your self-hosted Vaultwarden URL)" "" -}}
{{/* Work + sidebiz emails are prompted (not hardcoded) so the template
     stays publishable. bootstrap.sh forwards real values via
     --promptString on init, then chezmoi.toml caches them. */ -}}
{{- $workEmail           := promptStringOnce . "workEmail"           "Work git identity email (empty = use personal everywhere)" "" -}}
{{- $sidebizEmail        := promptStringOnce . "sidebizEmail"        "Side-business git identity email (empty = use personal everywhere)" "" -}}
{{- $personalName        := promptStringOnce . "personalName"        "Personal git display name (empty = use your GitHub username)" "" -}}
{{- $workName            := promptStringOnce . "workName"            "Work git display name (empty = use personal name)" "" -}}
{{- $sidebizName         := promptStringOnce . "sidebizName"         "Side-business git display name (empty = use personal name)" "" -}}
{{- $includeAgents       := promptBoolOnce   . "includeAgents"       "Sync ~/.config/agents skills + instructions (agent-agnostic; opencode reads it, symlinked into ~/.claude for Claude Code, readable by nvim/aider/cursor)" true -}}
{{- $agentsRepo          := promptStringOnce . "agentsRepo"          "Skills/agents repo to sync into ~/.config/agents as owner/repo (empty = none; ATHOME_AGENTS_REPO in bootstrap)" "" -}}
{{- $extraPackages       := promptStringOnce . "extraPackages"       "Extra packages to also install, space-separated (optional overlay on the curated set; or use ~/.config/athome/extra-packages)" "" -}}
{{/* slk (Slack TUI) default workspace. Prompted (not hardcoded) so the slk
     config template stays publishable — no real team id / workspace lands in
     the repo. Empty = no committed workspace block; slk falls back to the
     first workspace to connect (see ~/.config/slk/config.toml.tmpl). */ -}}
{{- $slackWorkspace      := promptStringOnce . "slackDefaultWorkspace" "slk default workspace slug, e.g. acme (empty = none; slk uses first workspace to connect)" "" -}}
{{- $slackTeamId         := promptStringOnce . "slackTeamId"         "slk default workspace Slack team id, e.g. T0XXXXXXX (empty = none; required for the slug above to resolve)" "" -}}
{{/* matterhorn (Mattermost TUI) server + login. Prompted (not hardcoded) so the
     config template stays publishable — no real host/email lands in the repo.
     The password is never here (macOS Keychain via passcmd). Empty = no server
     block; you fill host/user later. */ -}}
{{- $matterhornHost      := promptStringOnce . "matterhornHost"      "Matterhorn (Mattermost) server host, NO https://, e.g. mattermost.example.com (empty = none)" "" -}}
{{- $matterhornUser      := promptStringOnce . "matterhornUser"      "Matterhorn login (email or username), e.g. you@example.com (empty = none)" "" -}}

# No `encryption` key: age was dropped (D5) — there are no encrypted_* files in
# this repo, and with `pass` gone there's no driver for encrypted-files-in-repo.
# Secrets live in Bitwarden, resolved at runtime via rbw (never in tracked files).

[git]
    autoCommit = false
    autoPush   = false
{{- if eq .chezmoi.os "darwin" }}
    # Pin to Apple's git for cloning git-repo externals (tpm, zinit, ~/.claude).
    # nanobrew's git symlinks to its Cellar but its compiled-in exec-path points
    # at /opt/homebrew/opt/git/libexec/git-core (legacy, unpopulated), so its
    # `git-remote-https` helper is missing → externals fail with
    #   git: 'remote-https' is not a git command
    #   fatal: remote helper 'https' aborted session
    # whenever nanobrew's bin is first on PATH (as it is mid-bootstrap). chezmoi
    # shells out to this command for externals, so an absolute path to a git with
    # working helpers sidesteps PATH-order roulette entirely.
    command = "/usr/bin/git"
{{- end }}

[data]
    machineType  = {{ $machineType | quote }}
    hostname     = {{ $hostname | quote }}
    githubHandle = {{ $githubHandle | quote }}
    githubId     = {{ $githubId | quote }}

    # Optional overlay: extra packages installed on top of packages.yaml
    # (space-separated; or per-machine via ~/.config/athome/extra-packages).
    # Consumed by run_after_05-install-extra-packages.sh.
    extra_packages = {{ $extraPackages | quote }}

    # Identity emails per context. Personal = the GitHub noreply address derived
    # from your handle (+ numeric id when given). Empty handle = empty personal
    # email; set githubHandle (or ATHOME_GITHUB_HANDLE in bootstrap).
    {{- if and $githubId $githubHandle }}
    email_personal = {{ printf "%s+%s@users.noreply.github.com" $githubId $githubHandle | quote }}
    {{- else if $githubHandle }}
    email_personal = {{ printf "%s@users.noreply.github.com" $githubHandle | quote }}
    {{- else }}
    email_personal = ""
    {{- end }}
    email_work    = {{ $workEmail | quote }}
    email_sidebiz = {{ $sidebizEmail | quote }}

    # Friendly names per context. All prompted (empty = fall back: personal to
    # your GitHub handle; work/sidebiz to personal in the gitconfig templates)
    # so no real name is hardcoded — keeps the repo publishable.
    {{- if $personalName }}
    name_personal = {{ $personalName | quote }}
    {{- else if $githubHandle }}
    name_personal = {{ $githubHandle | quote }}
    {{- else }}
    name_personal = ""
    {{- end }}
    name_work     = {{ $workName | quote }}
    name_sidebiz  = {{ $sidebizName | quote }}

    # VPN config (empty = service default)
    netbird_management_url = {{ $netbirdMgmtUrl | quote }}
    nordvpn_country        = {{ $nordvpnCountry | quote }}

    # Bitwarden server (empty = US cloud bitwarden.com; EU = vault.bitwarden.eu;
    # or a self-hosted Vaultwarden URL). bw-setup runs `rbw config set base_url`.
    bitwarden_url          = {{ $bitwardenUrl | quote }}

    # Sync ~/.claude (skills + CLAUDE.md + AGENTIC-SYSTEMS.md + RTK.md) via
    # chezmoi external. Editor/agent-agnostic — opencode reads it directly,
    # Claude Code reads it natively, nvim can reference CLAUDE.md.
    include_agents = {{ $includeAgents }}

    # Which repo the ~/.claude external syncs (owner/repo). Empty = none; a fork
    # points this at its own. On legacy machines that pre-date this key, the
    # external falls back to <handle>/skills (see .chezmoiexternal.toml.tmpl).
    agents_repo = {{ $agentsRepo | quote }}

    # slk (Slack TUI) default workspace — slug + team id. Both prompted (empty =
    # omit the committed [workspaces.<slug>] block, slk falls back to the first
    # workspace to connect) so no real Slack identifier is hardcoded in the repo.
    # Consumed by ~/.config/slk/config.toml.tmpl.
    slack_default_workspace = {{ $slackWorkspace | quote }}
    slack_team_id           = {{ $slackTeamId | quote }}

    # matterhorn (Mattermost TUI) server + login. Empty = no server block in the
    # rendered config (see ~/.config/matterhorn/config.ini.tmpl). Password stays
    # in the macOS Keychain. Prompted → no real host/email hardcoded in the repo.
    matterhorn_host = {{ $matterhornHost | quote }}
    matterhorn_user = {{ $matterhornUser | quote }}

    # ── Prompt-key mirrors — DO NOT consume these in templates ────────────────
    # promptStringOnce/promptBoolOnce decide whether to prompt by looking up the
    # answer under the PROMPT key (camelCase). Templates consume the snake_case
    # keys above, so without these mirrors a re-render (`chezmoi init`, or ANY
    # change to this config template) can't find the prior answers and RE-PROMPTS
    # — silently blanking configured values. Persisting the camelCase keys makes
    # re-init prompt-free and non-destructive. (machineType/hostname/githubHandle/
    # githubId above are already camelCase → they need no mirror.) When you add a
    # prompt with a snake_case data key, add its camelCase mirror here too.
    netbirdManagementUrl  = {{ $netbirdMgmtUrl | quote }}
    nordvpnCountry        = {{ $nordvpnCountry | quote }}
    bitwardenUrl          = {{ $bitwardenUrl | quote }}
    workEmail             = {{ $workEmail | quote }}
    sidebizEmail          = {{ $sidebizEmail | quote }}
    personalName          = {{ $personalName | quote }}
    workName              = {{ $workName | quote }}
    sidebizName           = {{ $sidebizName | quote }}
    agentsRepo            = {{ $agentsRepo | quote }}
    extraPackages         = {{ $extraPackages | quote }}
    slackDefaultWorkspace = {{ $slackWorkspace | quote }}
    slackTeamId           = {{ $slackTeamId | quote }}
    matterhornHost        = {{ $matterhornHost | quote }}
    matterhornUser        = {{ $matterhornUser | quote }}
    includeAgents         = {{ $includeAgents }}
