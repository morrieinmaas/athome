#!/usr/bin/env bash
# secrets-restore — recover secrets on a (new) machine from the encrypted git vault.
#
#   1. clone the private vault repo from GitHub (or pull if already present)
#   2. unlock it with the git-crypt key pulled from Bitwarden (rbw)
#   3. copy the decrypted files into ~/.secrets/<repo>/.env, ~/.aws/*, etc. (chmod 600)
#
# This is step 4 of the lost-laptop recovery: athome → gh login → bw-setup → secrets-restore.
#   secrets-restore            # restore everything
#   secrets-restore --dry-run  # show what would be written, write nothing
set -uo pipefail
PATH="/opt/nanobrew/prefix/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
NAME="${SECRETS_VAULT_NAME:-attic}"
VAULT="${SECRETS_VAULT:-$HOME/.local/share/$NAME}"
GITCRYPT=/opt/nanobrew/prefix/bin/git-crypt
RBW=/opt/nanobrew/prefix/bin/rbw
GH=$(command -v gh || echo gh)
# Vault repo owner: explicit override, else the env handle, else the logged-in
# GitHub user (gh). Generic so a fork never points at someone else's namespace.
OWNER="${ATHOME_GITHUB_HANDLE:-$("$GH" api user -q .login 2>/dev/null || true)}"
REPO="${SECRETS_VAULT_REPO:-${OWNER}/$NAME}"
dry=0; [ "${1:-}" = "--dry-run" ] && dry=1

# 1. clone or pull
if [ -d "$VAULT/.git" ]; then ( cd "$VAULT" && git pull -q --ff-only 2>/dev/null || true )
else echo "cloning $REPO → $VAULT"; mkdir -p "$(dirname "$VAULT")"; "$GH" repo clone "$REPO" "$VAULT" -- -q; fi
cd "$VAULT" || exit 1

# 2. unlock if still encrypted (sentinel: is a known file ciphertext?)
sentinel=$(git ls-files | grep -v '^.gitattributes$' | head -1)
if [ -n "$sentinel" ] && [ "$(head -c 9 "$sentinel" | tr -d '\0')" = "GITCRYPT" ]; then
  "$RBW" unlocked >/dev/null 2>&1 || { echo "rbw is locked — run: rbw unlock, then re-run secrets-restore"; exit 1; }
  key=$(mktemp); "$RBW" get "git-crypt/$NAME-key" | tr -d '\n' | base64 -d > "$key"   # key = the item's password (base64)
  "$GITCRYPT" unlock "$key"; rm -f "$key"
  echo "unlocked vault with key from Bitwarden"
fi

# 3. copy decrypted files into place
rc=0
while IFS= read -r f; do
  [ "$f" = ".gitattributes" ] && continue
  target="$HOME/$f"
  if [ "$dry" = 1 ]; then echo "  would restore  $target"; continue; fi
  mkdir -p "$(dirname "$target")"
  if cp "$VAULT/$f" "$target" && chmod 600 "$target"; then echo "  restored  $target"; else echo "  FAIL  $f"; rc=1; fi
done < <(git ls-files)

# Harden the restored secrets tree: .env files are 600 (above); make ~/.secrets
# and its per-repo dirs owner-only too (mkdir -p leaves them umask-default).
if [ "$dry" = 0 ] && [ -d "$HOME/.secrets" ]; then
  chmod 700 "$HOME/.secrets"
  find "$HOME/.secrets" -mindepth 1 -type d -exec chmod 700 {} +
fi
exit $rc
