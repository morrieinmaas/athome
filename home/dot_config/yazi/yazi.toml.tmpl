# ~/.config/yazi/yazi.toml — managed by chezmoi
[mgr]
ratio          = [1, 3, 4]   # parent | current | preview — give the preview ~half the width
sort_by        = "natural"
sort_sensitive = false
sort_reverse   = false
sort_dir_first = true
linemode       = "size"
show_hidden    = false
show_symlink   = true

[preview]
tab_size       = 2
# Render previews at up to this many PIXELS. 600×900 was downscaling images well
# below a hi-dpi preview pane's real pixel size → blurry; bump high so ghostty's
# kitty graphics get sharp source pixels (capped by the actual pane size anyway).
max_width      = 1920
max_height     = 1920
image_filter   = "lanczos3"  # sharpest downscale filter (was triangle)
image_quality  = 90          # max preview quality (was 75)
ueberzug_scale = 1
ueberzug_offset = [0, 0, 0, 0]

[opener]
edit       = [{ run = 'nvim "$@"', block = true }]
{{ if eq .chezmoi.os "darwin" -}}
open       = [{ run = 'open "$@"', desc = "Open" }]
reveal     = [{ run = 'open -R "$@"', desc = "Reveal" }]
{{- else -}}
open       = [{ run = 'xdg-open "$@"', desc = "Open" }]
reveal     = [{ run = 'xdg-open "$(dirname "$1")"', desc = "Reveal (open folder)" }]
{{- end }}

[open]
rules = [
  { mime = "text/*",  use = "edit" },
  { mime = "image/*", use = "open" },
  { mime = "*",       use = "open" },
]

# Pre-rendered Markdown previews via glow (using the piper.yazi plugin, installed
# by .chezmoiscripts/run_onchange_15-install-yazi-plugins.sh). piper exposes
# $w = preview width. prepend = wins over the built-in plain-text previewer.
#
# We pin a custom glow style (styles/terminal.json) instead of glow's -s light/dark:
# glow downsamples to ANSI-16 when its stdout is a pipe (which it always is here),
# and glow's built-in styles use bright bg-block colors (yellow-on-blue headings,
# red-on-pale code) that the terminal's palette remaps into an unreadable mess.
# Our style uses foreground-only base-16 colors with NO background blocks, so the
# active theme (gruvbox/everforest/catppuccin…, light or dark) supplies correct,
# well-contrasted shades automatically — one style, every theme.
[plugin]
prepend_previewers = [
  { url = "*.md",       run = 'piper -- CLICOLOR_FORCE=1 glow -w=$w -s=$HOME/.config/glow/styles/terminal.json "$1"' },
  { url = "*.markdown", run = 'piper -- CLICOLOR_FORCE=1 glow -w=$w -s=$HOME/.config/glow/styles/terminal.json "$1"' },
]
