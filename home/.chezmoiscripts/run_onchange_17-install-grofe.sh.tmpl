#!/usr/bin/env bash
# Put grofe on this machine, answering to the name tmux.
#
# grofe is a terminal multiplexer that answers tmux's command line, so
# canopy, the plugins and every script that calls `tmux` run on it unchanged.
# It goes into ~/.local/lib/grofe:
#
#   grofe        the binary
#   bin/grofe    a symlink to it
#   bin/tmux     a symlink to it; grofe run under the name tmux speaks tmux
#
# ~/.zsh/path.zsh puts bin/ first on PATH, and canopy-tmux.service puts it first on
# the unit's PATH, so `tmux` is grofe in a shell and at login. The real tmux
# stays where the package manager put it.
#
# Going back to it is the bin/tmux symlink and nothing else: without it that
# directory holds only `grofe`, and the real tmux further along PATH answers
# every `tmux` again, in a shell and in the unit alike. `mux tmux` removes it
# and `mux grofe` puts it back (~/.local/bin/mux).
#
# ~/.config/athome/no-grofe is how that choice survives this script: present,
# the symlink is not made, so a `chezmoi apply` on a machine switched back to
# tmux leaves it switched back. It is per-machine and gitignored, the same
# place as extra-packages. grofe itself is still installed and still runs as
# `grofe`; only the tmux identity is withheld.
#
# Where the binary comes from, first match wins:
#
#   ATHOME_GROFE_BIN=<path>   a binary already built, copied as it is. Nothing
#                             is downloaded or built (the alias-day container
#                             test sets it to the grofe it built)
#   release                   the pinned release tarball from GROFE_RELEASE_BASE
#                             (default https://github.com/termage/grofe/releases/download),
#                             checked against its .sha256 file before it is installed
#
# run_onchange, keyed on the pin: change `pins.grofe` in home/.chezmoidata/pins.toml,
# and the next `chezmoi apply` installs that grofe.
#
# grofe pin: {{ .pins.grofe }}
set -euo pipefail

pin="{{ .pins.grofe }}"
base="${GROFE_RELEASE_BASE:-https://github.com/termage/grofe/releases/download}"
dest="${HOME}/.local/lib/grofe"

tmp=""
trap '[ -z "${tmp}" ] || rm -rf "${tmp}"' EXIT

sha() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}

mkdir -p "${dest}/bin"
if [ -n "${ATHOME_GROFE_BIN:-}" ]; then
  if [ ! -x "${ATHOME_GROFE_BIN}" ]; then
    printf 'grofe: ATHOME_GROFE_BIN=%s is not an executable file\n' "${ATHOME_GROFE_BIN}" >&2
    exit 1
  fi
  printf 'grofe: installing %s\n' "${ATHOME_GROFE_BIN}"
  install -m 755 "${ATHOME_GROFE_BIN}" "${dest}/grofe.new"
else
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) target=x86_64-unknown-linux-musl ;;
    Linux-aarch64 | Linux-arm64) target=aarch64-unknown-linux-musl ;;
    Darwin-x86_64) target=x86_64-apple-darwin ;;
    Darwin-arm64 | Darwin-aarch64) target=aarch64-apple-darwin ;;
    *)
      printf 'grofe: no release for %s %s, so grofe is not installed; tmux stays tmux\n' "$(uname -s)" "$(uname -m)" >&2
      exit 0
      ;;
  esac
  name="grofe-${pin}-${target}"
  url="${base}/${pin}/${name}.tar.gz"
  if ! command -v curl >/dev/null 2>&1; then
    printf 'grofe: curl not found, so grofe is not installed; tmux stays tmux\n' >&2
    exit 0
  fi
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/grofe-install.XXXXXX")"
  # A download that fails (offline, or a repository this machine cannot read)
  # keeps tmux instead of failing the whole apply.
  if ! curl -fsSL "${url}" -o "${tmp}/${name}.tar.gz" 2>/dev/null; then
    printf 'grofe: cannot download %s, so grofe is not installed; tmux stays tmux\n' "${url}" >&2
    exit 0
  fi
  if ! curl -fsSL "${url}.sha256" -o "${tmp}/${name}.tar.gz.sha256" 2>/dev/null; then
    printf 'grofe: cannot download %s.sha256, refusing to install an unchecked grofe\n' "${url}" >&2
    exit 1
  fi
  want="$(awk '{ print $1; exit }' "${tmp}/${name}.tar.gz.sha256")"
  got="$(sha "${tmp}/${name}.tar.gz")"
  if [ -z "${want}" ] || [ "${got}" != "${want}" ]; then
    printf 'grofe: checksum mismatch for %s: expected %s, got %s\n' "${name}.tar.gz" "${want:-nothing}" "${got}" >&2
    exit 1
  fi
  printf 'grofe: installing %s (%s)\n' "${pin}" "${target}"
  tar -xzf "${tmp}/${name}.tar.gz" -C "${tmp}"
  install -m 755 "${tmp}/${name}/grofe" "${dest}/grofe.new"
fi
# Moved into place, so a running server's next exec never sees half a file.
mv -f "${dest}/grofe.new" "${dest}/grofe"
ln -sfn ../grofe "${dest}/bin/grofe"

if [ -e "${HOME}/.config/athome/no-grofe" ]; then
  rm -f "${dest}/bin/tmux"
  printf 'grofe: %s, installed but not answering to tmux (~/.config/athome/no-grofe; `mux grofe` undoes that)\n' \
    "$("${dest}/grofe" -V)"
else
  ln -sfn ../grofe "${dest}/bin/tmux"
  printf 'grofe: %s, answering to tmux as: %s\n' "$("${dest}/grofe" -V)" "$("${dest}/bin/tmux" -V)"
fi
