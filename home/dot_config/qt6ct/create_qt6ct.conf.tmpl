; ~/.config/qt6ct/qt6ct.conf, written once by chezmoi (create_), then yours:
; qt6ct rewrites this file from its own settings window. Qt apps pick it up via
; QT_QPA_PLATFORMTHEME=qt6ct (niri environment block). The colour scheme is
; the one Noctalia's qt template writes from the shell palette.
[Appearance]
color_scheme_path={{ .chezmoi.homeDir }}/.config/qt6ct/colors/noctalia.conf
custom_palette=true
icon_theme=Papirus-Dark
standard_dialogs=default
style=Fusion
