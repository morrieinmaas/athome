#!/usr/bin/env bash
# theme — pick ONE colorscheme and apply it across ghostty + tmux + nvim at once.
#
# Runtime-only: edits your live ~/.config (instant), never the athome repo, so
# the committed default (gruvbox-light) is untouched. bat/delta/zed stay gruvbox
# (the only family all three bundle). See ~/.config/themes/registry.sh.
#
#   theme              # fzf picker (also: tmux `prefix T` popup)
#   theme <name>       # set directly: gruvbox everforest catppuccin tokyonight
#                      #   rose-pine kanagawa flexoki melange zenbones selenized dawn
#   theme --current    # print the active theme
#   theme --list       # list available themes
#   theme --swatch <n> # print a colour preview (used by the picker's fzf preview)
#   theme --preview <n> # recolour the live tmux + ghostty to <n>, leaving the
#                      #   active theme alone (the picker runs it as the cursor moves)
set -euo pipefail

# display-popup / run-shell give a bare non-login shell — make sure fzf, tmux and
# this script's deps resolve regardless of how we were launched. Appended, not
# prepended: under grofe the `tmux` first on the inherited PATH is grofe, and the
# real tmux in /opt/nanobrew cannot talk to grofe's server.
export PATH="$PATH:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/opt/nanobrew/prefix/bin:$HOME/.local/bin:/usr/bin:/bin"

dir="${HOME}/.config/themes"
# shellcheck source=/dev/null
. "$dir/registry.sh"

self="$(command -v theme 2>/dev/null || echo "$HOME/.local/bin/theme")"
current() { cat "$dir/active" 2>/dev/null || echo gruvbox; }

hex2rgb() { local h="${1#\#}"; printf '%d;%d;%d' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))"; }

swatch() {
  local name="$1" pal g
  pal="$(theme_tmux "$name")" || true
  [ -z "$pal" ] && { echo "  unknown theme: $name"; return 0; }
  eval "$pal"   # BG FG BLUE YELLOW GREEN GREY MUTED
  g="$(theme_ghostty "$name")"
  printf '\n  %s%s\n\n' "$name" "$( [ "$name" = "$(current)" ] && echo '  (active)')"
  printf '  '
  for c in "$BLUE" "$YELLOW" "$GREEN" "$GREY" "$FG" "$BG"; do
    printf '\033[48;2;%sm      \033[0m' "$(hex2rgb "$c")"
  done
  printf '\n  '
  printf '%-7s' blue yellow green grey fg bg
  printf '\n\n  ghostty : %s\n  nvim    : %s\n' "$g" "$(theme_nvim "$name")"
}

# Recolour the live ghostty and tmux to $1. ghostty gets the unmanaged override
# its config loads last (`config-file = ?theme`), then hot-reloads on SIGUSR2;
# never touch the chezmoi-managed config itself, that made every later apply
# fight the pick. tmux gets its pill palette via apply-tmux.sh.
paint() {
  if [ -d "${HOME}/.config/ghostty" ]; then
    printf 'theme = %s\n' "$(theme_ghostty "$1")" > "${HOME}/.config/ghostty/theme"
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi
  if command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    "$dir/apply-tmux.sh" "$1" || true
  fi
}

case "${1:-}" in
  --current) current; exit 0 ;;
  --list)    printf '%s\n' $THEME_LIST; exit 0 ;;
  --swatch)  swatch "${2:-$(current)}"; exit 0 ;;
  --preview) case " $THEME_LIST " in *" ${2:-} "*) paint "$2" ;; esac; exit 0 ;;
esac

name="${1:-}"
if [ -z "$name" ]; then
  command -v fzf >/dev/null || { echo "fzf not found — usage: theme <name>" >&2; exit 1; }
  height=40%; [ -n "${THEME_POPUP:-}" ] && height=100%   # fill the tmux popup
  was="$(current)"
  # Moving the cursor previews the theme live; Esc puts the active one back.
  name="$(printf '%s\n' $THEME_LIST | fzf \
            --prompt='theme> ' --height="$height" --reverse --no-multi \
            --header="current: $was  ·  move = preview  ·  enter = keep  ·  esc = back" \
            --bind "focus:execute-silent($self --preview {})" \
            --preview "$self --swatch {}" --preview-window='down,9,wrap')" || { paint "$was"; exit 0; }
fi
[ -z "$name" ] && exit 0

case " $THEME_LIST " in
  *" $name "*) ;;
  *) echo "unknown theme: $name (try: $THEME_LIST)" >&2; exit 1 ;;
esac

mkdir -p "$dir"
printf '%s\n' "$name" > "$dir/active"   # nvim fs-watches this dir; tmux.conf reads it on start

# ── ghostty + tmux: live ──
paint "$name"

# ── slk (Slack TUI): rewrite its [appearance] theme to the matching variant.
#    slk reads config fresh per launch, so this lands on the next `prefix M`. ──
[ -x "$dir/apply-slk.sh" ] && "$dir/apply-slk.sh" || true

# ── gh-dash: rewrite its theme: block to the matching family + dark/light.
#    gh-dash also reads config fresh per launch → lands on the next `prefix g`. ──
[ -x "$dir/apply-ghdash.sh" ] && "$dir/apply-ghdash.sh" || true

# ── superfile: regenerate its "athome" theme to the matching family + dark/light.
#    superfile reads its theme fresh per launch → lands on the next `spf`. ──
[ -x "$dir/apply-superfile.sh" ] && "$dir/apply-superfile.sh" || true

# ── niri: rewrite the focus-ring / border / insert-hint colours in config.kdl.
#    niri watches its config and hot-reloads, so this lands immediately on a
#    running compositor. No-op on machines without a niri config (i.e. macOS). ──
[ -x "$dir/apply-niri.sh" ] && "$dir/apply-niri.sh" || true

# ── Noctalia: switch the shell to the same family when it ships one built in.
#    `noctalia msg` writes Noctalia's own state file, never a managed one, and
#    its gtk/qt templates then recolour apps to match. Families it doesn't ship
#    leave the shell on its current scheme. No-op when Noctalia isn't running. ──
case "$name" in
  gruvbox)    noc=Gruvbox ;;
  kanagawa)   noc=Kanagawa ;;
  catppuccin) noc=Catppuccin ;;
  tokyonight) noc=Tokyo-Night ;;
  *)          noc="" ;;
esac
if [ -n "$noc" ] && command -v noctalia >/dev/null 2>&1; then
  noctalia msg color-scheme-set builtin "$noc" >/dev/null 2>&1 || true
fi

# ── btm (bottom): nothing to do — its config follows the terminal's ANSI palette
#    automatically, so it recolours with ghostty/tmux above. See registry.sh. ──

# ── nvim: live instances re-apply via their fs-watch on ~/.config/themes;
#          new instances read active on startup. ──

echo "theme → $name  (ghostty: live · tmux: live · nvim: live + next launch · slk/gh-dash/superfile: next launch)"
