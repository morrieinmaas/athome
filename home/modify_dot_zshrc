#!/bin/sh
# chezmoi modify_ script for ~/.zshrc, which is yours. athome's zsh setup lives
# in ~/.zsh/athome.zsh; this script only makes sure ~/.zshrc sources it, with
# one line, and passes every other line through verbatim. A new hook line goes
# at the top, so lines a tool appends (completions, `eval "$(x init zsh)"`) run
# after athome's compinit and PATH.
#
# Migration: a ~/.zshrc that athome rendered whole (the old "managed by chezmoi"
# header through its `.zshrc.local` line) is replaced by the hook line, in
# place, and the mise line scripts/install-mise.sh adds before bootstrap (marked
# "# athome: pre-bootstrap stopgap") goes. Lines you or a tool added stay.
set -eu

awk '
function is_hook(s) { return s !~ /^[ \t]*#/ && index(s, ".zsh/athome.zsh") }
{ line[NR] = $0 }
END {
  n = NR
  hook = "[[ -f \"$HOME/.zsh/athome.zsh\" ]] && source \"$HOME/.zsh/athome.zsh\""
  for (i = 1; i <= n; i++) if (index(line[i], "# ~/.zshrc — managed by chezmoi") == 1) { hs = i; break }
  if (hs) for (i = hs + 1; i <= n; i++) if (index(line[i], "source \"$HOME/.zshrc.local\"   # legacy path")) { he = i; break }
  if (he) {
    if (hs > 1 && line[hs - 1] ~ /^#!/) hs--
    for (i = hs; i <= he; i++) drop[i] = 1
  }
  for (i = 1; i <= n; i++) if (line[i] ~ /# athome: pre-bootstrap stopgap$/) drop[i] = 1
  for (i = 1; i <= n; i++) if (!drop[i] && is_hook(line[i])) { if (seen) drop[i] = 1; seen = 1 }
  if (!seen && !he) print hook
  for (i = 1; i <= n; i++) {
    if (he && i == hs && !seen) print hook
    if (!drop[i]) print line[i]
  }
}
'
