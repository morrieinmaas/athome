# Declarative externals fetched + refreshed by chezmoi itself.
# Beats run_once_ shell scripts: chezmoi handles update cadence, hash
# pinning, and clean uninstall (delete the entry, next apply removes).

# ── zinit (zsh plugin manager) ──────────────────────────────────────────────
# .zshrc also bootstraps zinit defensively on first launch — either path works.
[".local/share/zinit/zinit.git"]
    type          = "git-repo"
    url           = "https://github.com/zdharma-continuum/zinit.git"
    refreshPeriod = "168h"   # weekly

# ── TPM (tmux plugin manager) ───────────────────────────────────────────────
# tmux.conf also bootstraps TPM defensively. Plugins themselves are installed
# by .chezmoiscripts/run_onchange_after_14-install-tmux-plugins.sh on first apply.
[".config/tmux/plugins/tpm"]
    type          = "git-repo"
    url           = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"

# bat's gruvbox-light / gruvbox-dark themes are built in (no external needed).
# bottom also ships gruvbox built-in. Nothing to fetch here.

{{- /* ~/.config/agents — agent-AGNOSTIC home for skills + instructions
       (CLAUDE.md/AGENTS.md, AGENTIC-SYSTEMS.md, RTK.md, skills/, agents/) from
       your own agents repo. Read directly by opencode (instructions in
       dot_config/opencode/config.json) and symlinked into ~/.claude by
       run_once_after_22 so Claude Code finds it too — while Claude's own runtime
       (settings.json, projects/, sessions/, history.jsonl) stays in ~/.claude.
       Referencable from nvim/aider/cursor. NO IDE binaries installed by this.

       Sensitive bits are excluded by that repo's own .gitignore.

       Which repo comes from the `agentsRepo` prompt (owner/repo); emitted only
       when set AND includeAgents is true. Legacy machines fall back to
       <handle>/skills. Leaving agentsRepo empty syncs nothing. */ -}}
{{- $repo := "" -}}
{{- if hasKey . "agents_repo" -}}
{{-   $repo = .agents_repo -}}
{{- else if .githubHandle -}}
{{-   $repo = printf "%s/skills" .githubHandle -}}
{{- end -}}
{{ if and .include_agents $repo }}
# ── Agentic skills / instructions (agent-agnostic; ~/.config/agents) ────────
[".config/agents"]
    type          = "git-repo"
    url           = "git@github.com:{{ $repo }}.git"
    refreshPeriod = "168h"
{{ end }}
