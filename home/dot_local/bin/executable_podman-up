#!/bin/sh
# podman-up — ensure the container socket is live before a docker-API client runs.
# Shared by the docker→podman shim (dot_local/bin/docker) and the lazydocker
# wrapper (dot_zsh/functions.zsh), since lazydocker talks to the socket directly.
#
# macOS: podman runs in a VM that does NOT auto-start after a reboot, so its
# socket is dead until `podman machine start`. We only pay that cost when the
# socket is actually down — a ~15ms docker-API /_ping otherwise.
# Linux: the rootless podman.socket is systemd-managed + lingered (run_once_10),
# so this is a no-op.
[ "$(uname -s)" = Darwin ] || exit 0

sock="${DOCKER_HOST#unix://}"
[ -n "$sock" ] || sock=/var/run/docker.sock

# Fast, real-API liveness ping (avoids spawning podman on the hot path). The
# timeout is generous because under heavy load a healthy socket answers slowly;
# one retry covers a single dropped ping.
ping_sock() {
  /usr/bin/curl --max-time 5 -sf --unix-socket "$sock" http://d/_ping >/dev/null 2>&1
}

if ping_sock || ping_sock; then
  exit 0
fi

# Poll for the socket, at most $1 rounds.
wait_sock() {
  n=0
  while [ "$n" -lt "$1" ]; do
    ping_sock && return 0
    sleep 1
    n=$((n + 1))
  done
  return 1
}

machine_state() {
  podman machine inspect --format '{{.State}}' 2>/dev/null | head -n 1
}

wait_rounds="${PODMAN_UP_WAIT:-90}"
state=$(machine_state)

# A running or starting machine with a slow socket is load, not a dead VM:
# starting it again only adds to the pile-up.
if [ "$state" != stopped ]; then
  wait_sock "$wait_rounds" || echo "podman: socket not answering (machine state: ${state:-unknown})." >&2
  exit 0
fi

# Many parallel docker commands fail the ping at once; one of them starts the
# machine, the rest wait for the socket. The lock is a directory (mkdir is atomic)
# and counts as stale after 2 minutes, e.g. when its owner was killed.
lock="${TMPDIR:-/tmp}/podman-up.lock"
if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
  rm -rf "$lock"
fi

if ! mkdir "$lock" 2>/dev/null; then
  wait_sock "$wait_rounds" || echo "podman: socket still down after waiting for another start." >&2
  exit 0
fi
trap 'rm -rf "$lock"' EXIT
trap 'exit 1' INT TERM

# Another process may have finished the start between our check and the lock.
if [ "$(machine_state)" = stopped ]; then
  echo "podman: starting machine (first container command since boot)…" >&2
  podman machine start >/dev/null 2>&1 \
    || echo "podman: 'podman machine start' failed — start it manually." >&2
fi
