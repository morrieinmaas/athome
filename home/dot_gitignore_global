# Secrets — never commit env files, keys, certs, or tfvars (Action A).
# Primary control is rbw-at-runtime (secrets never enter tracked files); this
# is the backstop layer alongside the global gitleaks pre-commit hook.
.env
.env.*
!.env.example
*.pem
*.key
*.tfvars
# SSH private keys: OpenSSH default names + this setup's <identity>_ed25519
# convention. NOT a broad `id_*` glob — that would silently ignore source
# files like id_generator.py in every repo. .pub files stay tracked.
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_ed25519
!*_ed25519.pub

