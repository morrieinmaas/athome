#!/usr/bin/env bash
# secrets-backup — snapshot local secret files into the encrypted git vault and push.
#
# Mirrors ~/.secrets/<repo>/.env*, ~/.aws/*, scw/stripe, MCP configs into the git-crypt vault
# (~/.local/share/attic), commits (git-crypt encrypts on commit — deterministically, so
# unchanged files produce no diff = no churn), and pushes to the PRIVATE GitHub repo.
# Result: versioned, encrypted, off-site backup. GitHub only ever sees ciphertext.
# See docs/secrets.md → "Model B / versioned encrypted backup".
set -uo pipefail
PATH="/opt/nanobrew/prefix/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"
VAULT="${SECRETS_VAULT:-$HOME/.local/share/attic}"
GITCRYPT=/opt/nanobrew/prefix/bin/git-crypt

[ -d "$VAULT/.git" ] || { echo "vault not found at $VAULT — run 'secrets-restore' to clone it first"; exit 1; }

mirror() { local src="$1" rel="${1#"$HOME"/}"; [ -f "$src" ] || return 0; mkdir -p "$VAULT/$(dirname "$rel")"; cp "$src" "$VAULT/$rel"; }
for f in "$HOME"/.secrets/*/.env "$HOME"/.secrets/*/.env.*; do
  [ -e "$f" ] || continue; case "$f" in *.example|*.sample|*.template|*.dist) continue ;; esac; mirror "$f"
done
for f in "$HOME/.aws/config" "$HOME/.aws/credentials" \
         "$HOME/.config/scw/config.yaml" "$HOME/.config/stripe/config.toml" \
         "$HOME/.codeium/windsurf/mcp_config.json"; do mirror "$f"; done

cd "$VAULT"
git add -A
if git diff --cached --quiet; then echo "✓ vault already in sync (no changes)"; exit 0; fi

# SAFETY GATE: every staged secret file MUST be encrypted in the index before we commit/push.
bad=0
while IFS= read -r f; do
  [ "$f" = ".gitattributes" ] && continue
  magic=$(git cat-file -p ":$f" 2>/dev/null | head -c 9 | tr -d '\0')
  [ "$magic" = "GITCRYPT" ] || { echo "  !! NOT ENCRYPTED in index: $f"; bad=1; }
done < <(git diff --cached --name-only)
if [ "$bad" = 1 ]; then
  echo "ABORT: plaintext detected in staged files — refusing to commit/push. Is git-crypt unlocked & .gitattributes intact?"; exit 2
fi

git -c user.email="secrets@local" -c user.name="secrets-backup" commit -qm "secrets snapshot $(date -u +%Y-%m-%dT%H:%M:%SZ)"
if git push -q origin HEAD 2>/dev/null; then
  echo "✓ backed up + pushed ($(git rev-parse --short HEAD)) — $(git diff --name-only HEAD~1 2>/dev/null | grep -vc '^$') file(s) changed"
else
  echo "⚠ committed locally ($(git rev-parse --short HEAD)) but push failed (offline / no auth) — will push next run"
fi
