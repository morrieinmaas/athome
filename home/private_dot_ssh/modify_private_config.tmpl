#!/bin/sh
# chezmoi modify_ script for ~/.ssh/config, which is yours. athome's settings
# live in ~/.ssh/athome/*.conf; this script only makes sure the one line that
# pulls them in, `Include athome/*.conf`, sits above every Host and Match line
# (an Include below one would apply to that host only). Every other line is
# passed through verbatim.
#
# Migration: an ~/.ssh/config that athome rendered whole starts with the old
# "managed by chezmoi" header and ends with its `Host github.com` block. In that
# range the lines that match an old athome body in order (every version is in
# .chezmoitemplates/legacy/ssh-config/) are dropped; any other line there is
# yours and stays. A Host block you added keeps all its options, and an option
# you added under an old athome Host keeps that Host line. The github.com blocks bootstrap
# and run_before_00 seed go too. athome's content now lives in base.conf.
set -eu

known="$(mktemp)"
trap 'rm -f "$known"' EXIT
cat >"$known" <<'ATHOME_EOF'
{{ range $i := until 6 }}@@athome legacy v{{ add $i 1 }}@@
{{ includeTemplate (printf ".chezmoitemplates/legacy/ssh-config/v%d" (add $i 1)) $ }}{{ end -}}
ATHOME_EOF

awk '
{{ include ".chezmoitemplates/legacy/lcs.awk" }}
function is_hook(s) { s = tolower(s); return s ~ /^[ \t]*include[ \t]+athome\/\*\.conf[ \t]*$/ }
function is_block(s) { s = tolower(s); return s ~ /^[ \t]*(host|match)([ \t]|=)/ }
function is_github(s) { return s ~ /^Host[ \t]+github\.com[ \t]*$/ }
function is_seed(s) { return index(s, "# === seeded by scripts/lib/ssh.sh") == 1 || index(s, "# === chezmoi run_before_00 seed") == 1 }
END {
  # The old athome-rendered body: header through the end of its github.com block.
  for (i = 1; i <= n; i++) if (index(line[i], "# ~/.ssh/config — managed by chezmoi") == 1) { hs = i; break }
  if (hs) {
    for (i = hs + 1; i <= n; i++) if (is_github(line[i])) { he = i; break }
    if (he) {
      while (he < n && line[he + 1] ~ /^[ \t]+[^ \t]/) he++
      drop_legacy(hs, he)
      host = 0
      for (i = hs; i <= he; i++) {   # a Host block you added keeps every option
        if (is_block(line[i])) host = drop[i] ? 0 : i
        else if (host && line[i] ~ /^[ \t]+[^ \t]/) drop[i] = 0
      }
      host = 0
      for (i = hs; i <= he; i++) {   # your option under an old athome Host keeps it
        if (is_block(line[i])) host = i
        else if (!drop[i] && host && line[i] ~ /^[ \t]+[^ \t]/) drop[host] = 0
      }
    }
  }
  # Blocks bootstrap and run_before_00 append while the key is not pinned yet.
  for (i = 1; i <= n; i++) {
    if (drop[i] || !is_seed(line[i]) || !is_github(line[i + 1])) continue
    if (i > 1 && line[i - 1] == "" && !drop[i - 1]) drop[i - 1] = 1
    drop[i] = drop[i + 1] = 1
    for (j = i + 2; j <= n && line[j] ~ /^[ \t]+[^ \t]/; j++) drop[j] = 1
  }
  # Keep a hook that already sits above every Host/Match line; drop the rest.
  ok = 0
  for (i = 1; i <= n; i++) {
    if (drop[i]) continue
    if (is_block(line[i])) break
    if (is_hook(line[i])) { ok = i; break }
  }
  for (i = 1; i <= n; i++) if (!drop[i] && is_hook(line[i]) && i != ok) drop[i] = 1
  if (!ok) print "Include athome/*.conf"
  for (i = 1; i <= n; i++) if (!drop[i]) print line[i]
}
' "$known" -
