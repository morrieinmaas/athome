#!/usr/bin/env bash
# slk-auth — import Slack workspaces into slk without the interactive paste.
#
# The hard, tedious part is the `d` cookie (a 233-char blob, AES-encrypted in the
# Slack app's Cookies DB behind the macOS Keychain). slk-auth always handles that
# for you. The xoxc TOKEN can't be read reliably from the desktop app (its
# leveldb is Snappy-compressed and Slack rotates the live token in memory), so
# you supply the token — it's a trivial copy from Slack's own one-liner — and
# slk-auth does the rest: auth.test for team_id/name/slug, then writes slk's
# files (~/.local/share/slk/tokens/{TeamID}.json + config.toml block).
#
#   slk-auth                       # decrypt the cookie + print the token one-liner to run
#   slk-auth <xoxc-…> [<xoxc-…>]   # import: auto cookie + the token(s) you pass
#   slk-auth --print               # just print the decrypted cookie (manual paste path)
#
# Get the token: open Slack in your browser, DevTools console, run:
#   Object.entries(JSON.parse(localStorage.localConfig_v2).teams).forEach(([i,t])=>console.log(t.name,t.token))
# Nothing is committed; secrets only touch ~/.local/share/slk. macOS only.
set -euo pipefail

mode=import
toks=()
while [ $# -gt 0 ]; do
  case "$1" in
    --print) mode=print ;;
    --token) shift; [ $# -gt 0 ] && toks+=("$1") ;;
    xoxc-*)  toks+=("$1") ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "slk-auth: unknown arg '$1' (need an xoxc- token, --print, or no args)" >&2; exit 1 ;;
  esac
  shift
done

[ "$(uname -s)" = Darwin ] || {
  echo "slk-auth: macOS only for now (Linux Slack uses libsecret/kwallet)." >&2; exit 1; }

BASE=""
for b in \
  "$HOME/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack" \
  "$HOME/Library/Application Support/Slack"; do
  [ -d "$b" ] && { BASE="$b"; break; }
done
[ -n "$BASE" ] || {
  echo "slk-auth: Slack app data not found — desktop app installed + signed in?" >&2; exit 1; }

uv run --with pycryptodome python - "$mode" "$BASE" ${toks[@]+"${toks[@]}"} <<'PY'
import sys, os, re, json, sqlite3, subprocess, hashlib, urllib.request, urllib.parse
from pathlib import Path
from Crypto.Cipher import AES

mode, base = sys.argv[1], Path(sys.argv[2])
toks = list(dict.fromkeys(sys.argv[3:]))
ONELINER = ("Object.entries(JSON.parse(localStorage.localConfig_v2).teams)"
            ".forEach(([i,t])=>console.log(t.name,t.token))")

# ── decrypt the d cookie (the durable, tedious credential) ──
ck = next((p for p in [base/"Cookies", base/"Network/Cookies"] if p.exists()), None)
if not ck: sys.exit("slk-auth: no Cookies DB under the Slack data dir")
try:
    pw = subprocess.check_output(
        ["security","find-generic-password","-s","Slack Safe Storage","-w"]).strip()
except subprocess.CalledProcessError:
    sys.exit("slk-auth: Keychain read denied — re-run and click 'Always Allow' (Mac password once).")
key = hashlib.pbkdf2_hmac("sha1", pw, b"saltysalt", 1003, 16)
row = sqlite3.connect(f"file:{ck}?mode=ro", uri=True).execute(
    "select encrypted_value from cookies where name='d' order by length(encrypted_value) desc limit 1").fetchone()
if not row: sys.exit("slk-auth: no 'd' cookie in the Cookies DB")
dec = AES.new(key, AES.MODE_CBC, b" "*16).decrypt(row[0][3:])
dec = dec[:-dec[-1]]
if not dec.startswith(b"xoxd-"): dec = dec[32:]
cookie = dec.decode("utf-8", "replace")
print(f"d cookie ✓ decrypted ({len(cookie)} chars)")

# ── no token supplied: hand over the cookie + how to get the token ──
if not toks and mode != "print":
    print("\nThe xoxc token can't be auto-read from the desktop app (compressed store +")
    print("rotation). Grab it in 5s — open Slack in your browser, DevTools console, run:\n")
    print(f"  {ONELINER}\n")
    print("then re-run with the token(s) it prints:\n")
    print("  slk-auth xoxc-…  [xoxc-…]\n")
    sys.exit(0)

if mode == "print":
    print(f"\ncookie (d): {cookie}")
    print("\nRun `slk --add-workspace`, paste this cookie at 'Cookie (d)', your token at 'Token (xoxc)'.")
    sys.exit(0)

# ── import: validate each supplied token with the cookie, write slk's files ──
def auth_test(tok):
    req = urllib.request.Request("https://slack.com/api/auth.test",
        data=urllib.parse.urlencode({"token": tok}).encode(),
        headers={"Cookie": f"d={cookie}"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)

valid, seen = [], set()
for tok in toks:
    if not tok.startswith("xoxc-"):
        print(f"  {tok[:12]}…  not an xoxc- token, skipped"); continue
    try:
        info = auth_test(tok)
    except Exception as e:
        print(f"  {tok[:12]}…  auth.test failed: {e}"); continue
    if not info.get("ok"):
        print(f"  {tok[:12]}…  invalid ({info.get('error')}) — token stale? re-copy from the console one-liner"); continue
    if info["team_id"] in seen: continue
    seen.add(info["team_id"])
    slug = re.sub(r"^https?://", "", info.get("url","")).split(".")[0] or info["team_id"].lower()
    valid.append({"token": tok, "team_id": info["team_id"], "name": info.get("team",""), "slug": slug})
    print(f"  ✓ {info.get('team','?'):<24} [{slug}]  {info['team_id']}")

if not valid:
    sys.exit("\nslk-auth: no token validated. Re-copy from the browser console one-liner (above) and retry.")

xdg_data = Path(os.environ.get("XDG_DATA_HOME",   Path.home()/".local/share"))/"slk"
xdg_cfg  = Path(os.environ.get("XDG_CONFIG_HOME", Path.home()/".config"))/"slk"
tokdir   = xdg_data/"tokens"; cfgfile = xdg_cfg/"config.toml"
tokdir.mkdir(parents=True, exist_ok=True); os.chmod(tokdir, 0o700)
existing = cfgfile.read_text() if cfgfile.exists() else ""
blocks = []
for w in valid:
    fp = tokdir/f"{w['team_id']}.json"
    fp.write_text(json.dumps(
        {"access_token": w["token"], "cookie": cookie, "team_id": w["team_id"], "team_name": w["name"]},
        indent=2)); os.chmod(fp, 0o600)
    if f'team_id = "{w["team_id"]}"' not in existing and f"[workspaces.{w['slug']}]" not in existing:
        blocks.append(f"# {w['name'] or w['team_id']}\n[workspaces.{w['slug']}]\nteam_id = \"{w['team_id']}\"\n")
if blocks:
    xdg_cfg.mkdir(parents=True, exist_ok=True)
    sep = "" if (not existing or existing.endswith("\n")) else "\n"
    with cfgfile.open("a") as fh:
        for blk in blocks:
            fh.write(sep + "\n" + blk); sep = ""

print(f"\n✓ imported {len(valid)} workspace(s) → {tokdir}")
print("  Launch slk (or tmux `prefix M`). A running slk needs a restart to see them.")
PY
