# bootstrap.toml — non-interactive answers for scripts/bootstrap.sh
#
# Copy this to a gitignored file and fill it in, then point bootstrap at it:
#
#   cp examples/bootstrap.toml.example bootstrap.local.toml
#   $EDITOR bootstrap.local.toml
#   ./scripts/bootstrap.sh --config bootstrap.local.toml
#
# bootstrap auto-discovers (no --config needed) the first readable of:
#   1. the path you pass to --config
#   2. ./bootstrap.local.toml      (repo root — gitignored)
#   3. ~/.config/athome/bootstrap.toml
#
# Precedence: an ATHOME_* env var or a CLI flag (--machine, --no-agents) always
# wins over this file; this file only fills blanks. Every value is OPTIONAL —
# anything omitted/empty falls back to a sensible default (personal everywhere).
#
# This file never lands in the repo. bootstrap copies the answers into your OWN
# private ~/.config/chezmoi/chezmoi.toml — the same place chezmoi caches prompt
# answers — so nothing personal is ever committed.
#
# Parser is intentionally simple: `key = "value"`, one per line, and comments
# only on their own line (don't put a trailing `# …` after a value).

# personal | work. "personal" also covers sidehustle (per-dir git routing
# handles that separately). Same as the --machine flag.
machine = "personal"

# Your GitHub username. Empty = derived from the logged-in `gh` account.
githubHandle = ""

# Your GitHub numeric id (`gh api user -q .id`). Empty = fetched from the public
# api.github.com profile. Used to build the <id>+<handle>@users.noreply commit
# email; if it can't be resolved the plain <handle>@users.noreply form is used.
githubId = ""

# Personal git display name. Empty = your GitHub handle.
personalName = ""

# Work identity — only materialized on machine = "work".
# Empty = use your personal identity everywhere.
workEmail = ""
workName = ""

# Side-business identity (routed for repos under ~/sidebiz/).
# Empty = use your personal identity everywhere.
sidebizEmail = ""
sidebizName = ""

# Sync ~/.config/agents skills + instructions (agent-agnostic). true | false.
includeAgents = "true"

# Skills/agents repo to sync into ~/.config/agents as owner/repo. Empty = none.
agentsRepo = ""

# slk (Slack TUI) default workspace to open on launch: the slug + its Slack team
# id (e.g. "T0XXXXXXX"). Both empty = no committed workspace block; slk falls
# back to the first workspace to connect. Never hardcoded in the repo — these
# land only in your private ~/.config/chezmoi/chezmoi.toml.
slackDefaultWorkspace = ""
slackTeamId = ""

# matterhorn (Mattermost TUI) server host (NO https://) + login (email/username).
# Both empty = no server block in the rendered config. The password is never here
# — it's read from the macOS Keychain. Like the above, these land only in your
# private ~/.config/chezmoi/chezmoi.toml, never the repo.
matterhornHost = ""
matterhornUser = ""

# Extra packages to install on top of the curated set (space-separated; names
# valid for THIS machine's OS). Empty = none. Per-machine alternative: drop a
# ~/.config/athome/extra-packages file (one package per line). See docs/customizing.md.
extraPackages = ""

# ── Interactive-flow controls (used by a --non-interactive run) ──────────────
# Bitwarden is optional. "false" = local-only secrets (~/.secrets created, ready
# for hand-populated <repo>/.env; no Bitwarden). Default true (use it).
useBitwarden = "true"
# When an SSH key for this host already exists: use | generate (back up + fresh) |
# reupload (use it + push to GitHub). Default "use".
sshKeyAction = "use"
# Generate an SSH key when none exists. "false" = skip (bring your own / agent).
generateSshKey = "true"

# VPN (optional). Empty = service default.
# NetBird management URL — empty = NetBird Cloud SaaS; set when self-hosting.
netbirdManagementUrl = ""
# Mesh VPN: meshnet (NordVPN) | netbird | none. Empty = meshnet.
meshProvider = ""
# NordVPN auto-connect country — empty = NordVPN picks best.
nordvpnCountry = ""

# Bitwarden server URL (optional). Empty = US cloud (bitwarden.com).
# EU cloud: "https://vault.bitwarden.eu". Self-hosted Vaultwarden: your URL.
# bw-setup runs `rbw config set base_url` with this value.
bitwardenUrl = ""
