# ~/.config/canopy/user.conf — managed by chezmoi.
#
# canopy sources this LAST, after every layer it ships, so anything set here
# wins. What lives here is what canopy cannot ship: keys that launch this
# machine's tools by absolute path, a status bar that calls this machine's
# scripts, and plugins canopy does not vendor.
#
# What LEFT this file when canopy took over, so it is not set twice:
#
#   prefix C-s, send-prefix           canopy 00-core + its key table
#   terminal-features, extended-keys  canopy 00-core
#   allow-passthrough, automatic-rename, allow-rename, set-clipboard,
#   mode-keys, escape-time, history-limit, mouse, renumber-windows,
#   base-index, pane-base-index       canopy 00-core
#   splits, cockpit layout, hjkl, HJKL, reload, session cycling
#                                     canopy's key table (tmux/keys.tsv)
#   @continuum-restore, @continuum-save-interval,
#   @resurrect-strategy-nvim          canopy 30-plugins
#   @resurrect-processes              canopy generates it from installed adapters
#   tmux-resurrect, tmux-continuum    canopy vendors both at pinned commits
#
#   every other plugin, and TPM       canopy vendors and loads them all
#
# That last group matters most: loading resurrect and continuum a second time
# would be two save loops writing one file and two restores racing at boot.

# --- what canopy does not set ----------------------------------------------

# The cockpit layout's left pane. canopy binds the layout (prefix c, prefix V)
# but takes no view on how wide it should be.
setw -g main-pane-width 50%

# Pin the pane shell. tmux defaults it to the server's $SHELL, and on a fresh
# box the desktop session predates the chsh to zsh, so SHELL=bash and every
# new pane opened bash (same trap as Ghostty's `command`). default-shell must
# be an absolute path, hence lookPath at render time.
{{ with lookPath "zsh" -}}
set -g default-shell "{{ . }}"
{{ end -}}

# --- this machine's keys ---------------------------------------------------
# Every one of these names a tool or a path that belongs to this machine, so
# none of them could ship in a distribution.
#
# The mise shims are called by ABSOLUTE path on purpose: display-popup runs
# its command in the tmux SERVER's environment, and that environment is a
# snapshot of whichever shell first started the server, never refreshed.
#
# This comment used to say the shims dir "is not on PATH there", and that
# was simply wrong: it IS, because the shell that started the server had it.
# The error was expensive. It is the reason nobody looked at the server's
# PATH when `prefix r` started taking 32 seconds, which turned out to be a
# stale mise `tmux` shim (left behind by canopy's own mise.toml, which
# installs tmux for its test suite) answering every one of the hundreds of
# bare `tmux` calls a plugin load makes, at 134ms each instead of 5.8ms.
# canopy fixes that itself now, in conf.d/00-core.conf, by putting a symlink
# to the running server's own binary first on the server's PATH; `canopy
# doctor` reports it as "bare tmux in a server job".
#
# Absolute paths here are still right, and now for the stated reason rather
# than a wrong one: what the server's PATH holds depends on how the server
# happened to start, so naming the file removes the question.

bind B run-shell '$HOME/.local/bin/cockpit'
bind g display-popup -E -w 95% -h 90% '$HOME/.config/themes/apply-ghdash.sh 2>/dev/null; exec $HOME/.local/share/mise/shims/gh-dash'
bind G display-popup -E -w 95% -h 90% -d '#{pane_current_path}' '$HOME/.config/tmux/enhance-pr.sh'
bind M new-window -n slack '$HOME/.config/themes/apply-slk.sh 2>/dev/null; exec $HOME/.local/share/mise/shims/slk'
bind N new-window -n mattermost '$HOME/.local/bin/matterhorn'
bind P display-popup -E -b none -w 60% -h 80% '$HOME/.config/tmux/pet-pick.sh'
bind T display-popup -E -b none -w 50% -h 55% 'THEME_POPUP=1 $HOME/.local/bin/theme'
bind W display-popup -E -b rounded -T " network " -w 66 -h 26 '$HOME/.config/tmux/net-popup.sh'
bind K run-shell '$HOME/.local/bin/tsess'

# prefix ? — searchable list of every binding, over the whole key table.
# canopy plans its own palette and which-key for M4 on prefix : and prefix ?,
# and this line will win over it until it is deliberately removed.
bind ? run-shell '$HOME/.config/tmux/keys-popup.sh'

# Click the network pills for detail. The else branch reproduces tmux's OWN
# default for this key with a two-line status, which is `switch-client -t =`,
# not select-window: get it wrong and clicking anywhere else on the status
# line silently stops working.
bind -n MouseDown1Status if -F '#{m:*net*,#{mouse_status_range}}' \
  'display-popup -E -b rounded -T " network " -w 66 -h 26 "$HOME/.config/tmux/net-popup.sh #{mouse_status_range}"' \
  'switch-client -t ='

# --- the plugins' settings -------------------------------------------------
# No TPM. canopy vendors every plugin this machine uses, pinned by commit, and
# its loader runs them after this file is read, so these options are set
# before each plugin looks for them. vim-tmux-navigator's tmux side is canopy's
# own 40-nav layer. canopy's tmux.conf also takes prefix C-s back from
# opensessions after the loader.

set -g @fzf-url-history-limit '2000'
set -g @claude_launch_key 'a'
set -g @claude_list_key   'A'
set -g @sessionx-bind         's'
set -g @sessionx-zoxide-mode  'on'
set -g @sessionx-window-mode  'on'
# alt-bspace sat one modifier away from plain backspace, so fixing a typo in
# the query could kill a session. The action behind it is replaced too, see
# sessionx.sh below.
set -g @sessionx-bind-kill-session 'alt-x'

# Re-assert what plugins clobber at load.
#
# Both bindings below used to sit after `run .../tpm` in this very file, so
# they already came after the plugins. canopy's loader runs them AFTER the
# whole of user.conf instead, so a plain binding here is set first and then
# taken by the plugin, which is the opposite of what these two lines are for.
#
# opensessions hard-binds prefix C-s to sidebar-focus, taking the send-prefix
# binding canopy's key table declares. canopy puts that one back itself, after
# its loader (tmux/tmux.conf), so this line is belt and braces for a server
# where the loader did not run at all; prefix o s still reaches the sidebar.
bind C-s send-prefix

# prefix s through our wrapper: kill asks first and kills the WINDOW on a
# window line, rename and kill reload the window list, the header is words.
# sessionx binds @sessionx-bind (s) to its own script as it loads, so this
# one canopy does not know about is re-asserted on attach: the plugins are
# long loaded by then, the same key bound to the same command is idempotent,
# and -ga appends rather than replacing whatever else wants the hook. The
# plain binding stays as well, so `prefix s` works on a server whose plugins
# never loaded.
bind s run-shell '$HOME/.config/tmux/sessionx.sh'
set-hook -ga client-attached "bind-key s run-shell '$HOME/.config/tmux/sessionx.sh'"

# Killing the session you are in moves you to the previous one instead of
# exiting tmux (the default, `on`, detaches the client).
set -g detach-on-destroy previous

# Unnamed sessions are named after their repo or directory (session-name.sh).
set-hook -g session-created "run-shell \"$HOME/.config/tmux/session-name.sh '#{hook_session_name}'\""

# which-key rebuilds its menu when canopy's loader sources it, after this
# file, so this has to wait for that rather than run inline.
run-shell -b '$HOME/.config/tmux/wk-keys-fix.sh'

# --- the status bar --------------------------------------------------------
# This machine's bar, kept whole. canopy ships its own in 20-status and this
# overrides it, which is the supported way round: canopy's colours come from
# the same @theme_* options the `theme` picker writes, so a theme still
# repaints everything either way.
#
# One line here is load bearing and easy to lose. tmux-continuum PREPENDS
# `#(continuum_save.sh)` to whatever status-right holds when it loads, and
# that interpolation IS the autosave: it fires on status redraws. Setting
# status-right here, after canopy's plugin layer, removes it, so the call is
# put back explicitly at the end of the line below, now pointing at canopy's
# vendored copy rather than the TPM one. `canopy doctor` checks for it.

set -g status 2
set -g status-format[1] ""
set -g status-justify left
set -g status-interval 5
set -g status-style "bg=default,fg=#{@theme_fg}"
set -g status-left-length  100
set -g status-right-length 200

# The bar drops segments as the terminal narrows, so left and right never
# collide: below 150 columns the network pills go (they alone are ~50 wide),
# below 110 the pet, battery, date and hostname, leaving session, windows and
# the clock. Segments with commas in their styles live in @seg_* options and
# are expanded with #{E:}, because a comma inside a #{?…} branch splits it.
set -g @seg_host '#[fg=#{@theme_grey},bg=default]#{@pill_l}#[fg=#{@theme_bg},bg=#{@theme_grey},bold] #h #[fg=#{@theme_grey},bg=default,nobold]#{@pill_r} '
set -g @seg_sess '#[fg=#{?client_prefix,#{@theme_red},#{@theme_blue}},bg=default]#{@pill_l}#[fg=#{@theme_bg},bg=#{?client_prefix,#{@theme_red},#{@theme_blue}},bold] #S #[fg=#{?client_prefix,#{@theme_red},#{@theme_blue}},bg=default,nobold]#{@pill_r}  '
set -g @seg_date '#[fg=#{@theme_grey},bg=default]#{@pill_l}#[fg=#{@theme_fg},bg=#{@theme_grey}] %a %d %b #[fg=#{@theme_grey},bg=default]#{@pill_r}  '
set -g @seg_time '#[fg=#{@theme_green},bg=default]#{@pill_l}#[fg=#{@theme_bg},bg=#{@theme_green},bold] %H:%M #[fg=#{@theme_green},bg=default,nobold]#{@pill_r} '
set -g status-left "#{?#{e|<:#{client_width},110},,#{E:@seg_host}}#{E:@seg_sess}"

set -g window-status-separator " "
set -g window-status-format "#[fg=#{@theme_muted},bg=default] #I#{?#W, #W,} "
# tmux 3.8 changed the default window-status-current-style from `default` to
# `underscore`, which underlined the current-window pill. Its look comes
# entirely from the format below, so pin the style plain.
set -g window-status-current-style default
# The zoom magnifier (nerd-font U+F002). canopy ships a plain "+" inline and no
# @pill_zoom, so define it here or the zoomed pill shows nothing.
run-shell 'tmux set -g @pill_zoom "$(printf "\xef\x80\x82")"'
set -g window-status-current-format "#[fg=#{@theme_yellow},bg=default]#{@pill_l}#[fg=#{@theme_fg},bg=#{@theme_yellow},bold] #I#{?#W, #W,}#{?window_zoomed_flag, #{@pill_zoom},} #[fg=#{@theme_yellow},bg=default,nobold]#{@pill_r}"

set -g @pet 'on'
set -g @batt 'on'
set -g @net 'on'
# The continuum_save.sh call at the end is the autosave and must stay
# unconditional (see above); everything before it is optional.
set -g status-right "#{?#{e|<:#{client_width},110},,#{?@pet,#[bg=default] #(~/.config/tmux/pet.sh)  ,}}#{?#{e|<:#{client_width},150},,#{?@net,#[bg=default]#[range=user|net]#(~/.config/tmux/net.sh)#[norange]  ,}}#{?#{e|<:#{client_width},110},,#{?@batt,#[bg=default]#(~/.config/tmux/battery.sh)  ,}}#{?#{e|<:#{client_width},110},,#{E:@seg_date}}#{E:@seg_time}#({{ .chezmoi.homeDir }}/.local/share/canopy/plugins/tmux-continuum/scripts/continuum_save.sh)"

# Apply the theme (the one picked with `theme`, else gruvbox) on every start:
# the pill colours, and tmux 3.8's popup, menu and copy-mode colours, which are
# grey and goldenrod otherwise. Overrides the defaults canopy's 20-status sets.
run-shell "~/.config/themes/apply-tmux.sh"
