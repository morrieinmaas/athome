{{- /* Auto-populated from ~/.ssh/<id>_ed25519.pub. Each line is only
       emitted if the corresponding key exists, so this file is harmless
       on a fresh machine and self-fills as bootstrap.sh generates keys. */ -}}
{{- $home := .chezmoi.homeDir -}}
{{- $personalPub := joinPath $home ".ssh/personal_ed25519.pub" -}}
{{- $workPub     := joinPath $home ".ssh/work_ed25519.pub"     -}}
{{- $sidebizPub  := joinPath $home ".ssh/sidebiz_ed25519.pub"  -}}
{{ if stat $personalPub -}}
{{ .email_personal }} {{ output "cat" $personalPub | trim }}
{{ end -}}
{{- if stat $workPub -}}
{{ .email_work }} {{ output "cat" $workPub | trim }}
{{ end -}}
{{- if stat $sidebizPub -}}
{{ .email_sidebiz }} {{ output "cat" $sidebizPub | trim }}
{{ end -}}
