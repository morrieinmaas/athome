#!/bin/sh
# podman-fix-vfkit — restore vfkit's virtualization entitlement after nanobrew.
#
# nanobrew re-signs podman ad hoc on install and drops the entitlements vfkit
# needs to run the applehv VM. Without com.apple.security.virtualization the
# machine crashes or its API drops with EOF under load. Run this right after
# `nb upgrade podman` (run_after_27 also runs it on every chezmoi apply).
#
# Idempotent: re-signs only when the entitlement is missing. `--check` reports
# and changes nothing (exit 0 entitled or nothing to do, 1 when a fix is due).
# After a re-sign, restart the VM: podman machine stop && podman machine start.
set -eu

[ "$(uname -s)" = Darwin ] || exit 0

nb_prefix=/opt/nanobrew/prefix
export PATH="$nb_prefix/bin:$PATH"

check=0
[ "${1:-}" = --check ] && check=1

command -v podman >/dev/null 2>&1 || exit 0
version=$(podman --version | awk '{print $NF}')
vfkit="$nb_prefix/Cellar/podman/$version/libexec/podman/vfkit"

# Not a nanobrew podman (e.g. Homebrew's): nothing for us to fix.
[ -x "$vfkit" ] || exit 0

if codesign -d --entitlements - "$vfkit" 2>&1 | grep -q com.apple.security.virtualization; then
  echo "podman-fix-vfkit: vfkit $version already entitled"
  exit 0
fi

if [ "$check" = 1 ]; then
  echo "podman-fix-vfkit: vfkit $version lacks the virtualization entitlement" >&2
  exit 1
fi

plist=$(mktemp "${TMPDIR:-/tmp}/vfkit-entitlements.XXXXXX")
trap 'rm -f "$plist"' EXIT
cat >"$plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <key>com.apple.security.virtualization</key>
  <true/>
</dict>
</plist>
PLIST

codesign --force --sign - --entitlements "$plist" "$vfkit"
echo "podman-fix-vfkit: re-signed vfkit $version; restart the VM (podman machine stop && podman machine start)"
