# ─── Hard blocks: never commit, regardless of path ──────────────────────────
# Private keys
*.key
*.pem
*.p12
*.pfx
*_rsa
*_dsa
*_ecdsa
*_ed25519
!*_ed25519.pub
!*_rsa.pub
id_rsa
id_dsa
id_ecdsa
id_ed25519

# age / GPG private keys
key.txt
*.age
*.asc.private
secring.*
private-keys-v1.d/

# Cloud / service credentials
.aws/credentials
.aws/config
.gcp/
.azure/
.kube/config
*service-account*.json
*credentials*.json
*-creds.json
archinstall-creds.json

# Env files (use direnv + pass instead)
.env
.env.*
!.env.example
!.env.sample
*.envrc.local

# Non-interactive bootstrap answers (may hold work/sidebiz emails + names).
# The committed template is examples/bootstrap.toml.example.
bootstrap.local.toml
bootstrap.*.toml
!examples/bootstrap.toml.example

# Password store (sometimes accidentally cloned into repo)
.password-store/

# chezmoi-decrypted artifacts that should never be in this source repo
**/decrypted/
**/*.decrypted

# Tokens / secrets dumped by tools
.netrc
.pypirc
.npmrc
!.npmrc.example

# ─── OS noise ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes
.fseventsd

# ─── Editors ────────────────────────────────────────────────────────────────
.idea/
.vscode/
.zed/
.cursor/
*.swp
*.swo
*~

# ─── Build / cache ──────────────────────────────────────────────────────────
node_modules/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
target/

# Claude Code per-machine state. settings.local.json holds machine-local
# permissions and paths; the shared .claude/settings.json (if one is ever
# added) is meant to be committed, so only the .local variant is ignored.
# This matters because athome is publishable and a stray `git add -A` would
# otherwise sweep it in.
.claude/settings.local.json
