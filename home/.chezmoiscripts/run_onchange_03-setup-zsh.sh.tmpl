#!/usr/bin/env bash
# Set zsh as the login shell + bootstrap zinit. Cross-platform.
#
# `run_onchange_*.sh.tmpl`: chezmoi re-runs this whenever the rendered
# content changes. The token below captures zsh's path — if zsh wasn't
# installed on the previous apply but is now, the rendered content
# differs and the script re-runs and finishes the chsh step. No manual
# state-bucket bust needed.
#
# zsh-presence: {{ if lookPath "zsh" }}{{ lookPath "zsh" }}{{ else }}absent{{ end }}
set -euo pipefail

# In minimal/container shells (e.g. the e2e's `ci` user) $USER may be unset.
# This script runs under `set -u`, so the bare `$USER` uses below would abort
# with "USER: unbound variable". Derive it once up front from `id` as a fallback.
export USER="${USER:-$(id -un)}"

# Helper: append a manual follow-up note (printed by bootstrap.sh at end).
followup() {
  if [[ -n "${ATHOME_FOLLOWUP_LOG:-}" ]]; then
    printf '  • %s\n' "$*" >> "$ATHOME_FOLLOWUP_LOG"
  fi
}

zsh_bin="$(command -v zsh || true)"
if [[ -z "$zsh_bin" ]]; then
  echo "zsh not installed yet; deferring (will retry on next chezmoi apply)"
  if command -v dnf >/dev/null 2>&1 && ! command -v pacman >/dev/null 2>&1; then
    followup "zsh missing — install it (\`sudo dnf install -y zsh\`), then re-run chezmoi apply"
  else
    followup "zsh missing — install it (\`pacman -S zsh\` or \`brew install zsh\`), then re-run chezmoi apply"
  fi
  exit 0
fi

# /etc/shells gate
if ! grep -qx "$zsh_bin" /etc/shells; then
  echo "$zsh_bin" | sudo tee -a /etc/shells >/dev/null
fi

# Detect current login shell — cross-platform.
current_shell=""
if command -v dscl >/dev/null 2>&1; then
  current_shell="$(dscl . -read "/Users/$USER" UserShell 2>/dev/null | awk '{print $2}' || true)"
fi
if [[ -z "$current_shell" ]] && command -v getent >/dev/null 2>&1; then
  current_shell="$(getent passwd "$USER" | cut -d: -f7)"
fi
[[ -z "$current_shell" ]] && current_shell="${SHELL:-}"

if [[ "$current_shell" != "$zsh_bin" ]]; then
  echo "==> changing default shell: $current_shell → $zsh_bin"
  # `sudo chsh -s <shell> <user>` avoids the PAM password prompt that plain
  # `chsh` triggers; sudo keep-alive (set by bootstrap.sh) means no prompt here.
  if sudo chsh -s "$zsh_bin" "$USER" 2>/dev/null; then
    echo "✓ default shell set to zsh"
    followup "Reload your current terminal to use zsh: \`exec zsh\` (or close + reopen)"
  else
    echo "!! sudo chsh failed; fall back to non-sudo chsh"
    if chsh -s "$zsh_bin" 2>/dev/null; then
      echo "✓ default shell set to zsh"
      followup "Reload your current terminal: \`exec zsh\` (or log out + back in)"
    else
      followup "Change default shell manually: \`sudo chsh -s $zsh_bin $USER\` then \`exec zsh\`"
    fi
  fi
fi

# zinit is NOT cloned here. It has a single declarative owner — the
# `.chezmoiexternal.toml.tmpl` entry (type = git-repo) — which chezmoi clones
# on first apply and `git pull`s thereafter. `dot_zshrc.tmpl` self-bootstraps it
# on first interactive shell launch as a defensive backup.
#
# This script used to ALSO `git clone` it. That fought the external: chezmoi
# plans a clone at apply start (dir absent), then this script created the dir
# mid-apply, so the external's hard `git clone` then failed with exit 128
# ("destination path already exists / not empty") and aborted bootstrap. One
# owner = no race. See git history if you ever need the old belt+braces block.
echo "✓ zinit managed by chezmoi external (.chezmoiexternal.toml) + zshrc self-bootstrap"
