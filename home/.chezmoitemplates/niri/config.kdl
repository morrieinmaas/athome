// ~/.config/niri/config.kdl — managed by chezmoi
// Tweak interactively with `nirimod` (live-validates and preserves comments).
// Validate manually: `niri validate -c ~/.config/niri/config.kdl`
//
// Shell: Noctalia (Quickshell). Authoritative IPC verb list lives at
//   `noctalia msg --help` on the machine (57 verbs in v5.1.0)
// Compositor recommendations from upstream:
//   https://docs.noctalia.dev/noctalia/   (v5; the v4 tree is unmaintained)
//
// Anything Noctalia replaces natively (fuzzel/mako/swayidle/swaylock/polkit-
// gnome/cliphist/wpctl/brightnessctl direct calls) is NOT spawned/used here.

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:ctrl_modifier"
        }
        repeat-delay 250
        repeat-rate  35
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }

    mouse {
        accel-profile "flat"
    }

    // input{} children per niri source (lib.rs: focus_follows_mouse,
    // workspace_auto_back_and_forth).
    focus-follows-mouse
    workspace-auto-back-and-forth
}

// ThinkPad internal display. Run `niri msg outputs` to discover your real
// output name if eDP-1 doesn't match.
output "eDP-1" {
    mode "2560x1600@60.000"
    scale 1.25
    position x=0 y=0
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color   "#83a598"
        inactive-color "#a89984"
    }

    border {
        off
        width 2
        active-color   "#83a598"
        inactive-color "#a89984"
    }

    insert-hint {
        color "#d8a657"
    }

    // Soft drop shadows, the thing most polished niri setups add first: they
    // lift floating and overlapping windows off the wallpaper.
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=5
        color "#00000070"
    }
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }

// Noctalia is the official Noctalia recommendation — propagates these
// vars to its own subprocesses + matugen-themed apps.
environment {
    XDG_CURRENT_DESKTOP  "niri"
    QT_QPA_PLATFORM      "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"     // Qt apps take icons + Noctalia's colours from qt6ct
    GDK_BACKEND          "wayland,x11"
    MOZ_ENABLE_WAYLAND   "1"
    XDG_SESSION_TYPE     "wayland"
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size  24
}

// ── spawn-at-startup ────────────────────────────────────────────────────────
// Noctalia is the *only* shell-thing we spawn. It internally provides
// the launcher (was fuzzel), notifications (was mako), lockscreen (was
// swaylock), idle handler (was swayidle), polkit agent (was polkit-
// gnome), clipboard history (was cliphist + wl-paste watchers), and
// wallpaper daemon (was swww-daemon). Adding any of those alongside
// Noctalia is duplicate work that fights over the same Wayland
// protocols / D-Bus names.
// v5 ships a real binary; v4 was a Quickshell CONFIG NAME launched as
// `qs -c noctalia-shell`. Bare `noctalia` runs the shell in the foreground,
// which is what niri wants for a spawned child (`-d` would daemonise it).
spawn-at-startup "noctalia"

screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

// ── window rules ────────────────────────────────────────────────────────────
// Per docs.noctalia.dev/noctalia/ (v5),
// 20px corner radius is the Noctalia upstream recommendation; matches
// the panel/dock visuals.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Per Noctalia upstream: avoids spurious focus-snatch attempts from
// processes that didn't update their xdg-activation token correctly
// (the bar widget, system tray clicks, etc.).
debug {
    honor-xdg-activation-with-invalid-serial
}

// ── binds ───────────────────────────────────────────────────────────────────
// Noctalia IPC verbs verified against:
//   https://github.com/noctalia-dev/noctalia-shell/blob/main/Services/Control/IPCService.qml
// Discover the full verb tree on-machine: `noctalia msg --help`,
// and per-verb arguments with e.g. `noctalia msg session --help`.
binds {
    // Hotkey overlay (niri's own — shows everything below)
    Mod+Shift+Slash    { show-hotkey-overlay; }

    // ─── App launchers / spawn ──────────────────────────────────────────────
    Mod+Return         { spawn "ghostty"; }
    Mod+B              { spawn "zen-browser"; }
    // superfile (spf) is mise-managed; the niri session PATH lacks the mise
    // shims, so launch via an interactive shell (sources path.zsh → shims on
    // PATH, and defines the spf() wrapper that passes -c for the config).
    Mod+E              { spawn "ghostty" "-e" "zsh" "-ic" "spf"; }

    // ─── Noctalia panels / launchers (via its IPC) ──────────────────────────
    // Generic launcher (Noctalia's, replaces fuzzel).
    Mod+Space          { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    // Launcher in dedicated modes — much nicer than the cliphist+fuzzel chain.
    Ctrl+Alt+V         { spawn "noctalia" "msg" "panel-toggle" "launcher" "clipboard"; }
    Ctrl+Alt+E         { spawn "noctalia" "msg" "panel-toggle" "launcher" "emoji"; }
    Ctrl+Alt+W         { spawn "noctalia" "msg" "panel-toggle" "launcher" "windows"; }
    // Control center + settings + bar peek (per Noctalia's recommended binds).
    Mod+S              { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma          { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+N              { spawn "noctalia" "msg" "panel-toggle" "notifications"; }
    Mod+Shift+T        { spawn "noctalia" "msg" "theme-mode-toggle"; }

    // ─── Lock / session ─────────────────────────────────────────────────────
    // Use Noctalia's native lockscreen IPC. systemd-logind compatibility
    // is preserved separately: loginctl lock-session is the standard
    // event Noctalia listens for too, so either path triggers the same
    // lockscreen.
    Mod+L              { spawn "noctalia" "msg" "session" "lock"; }

    // ─── Window focus / move ────────────────────────────────────────────────
    Mod+Left           { focus-column-left;  }
    Mod+Right          { focus-column-right; }
    Mod+Down           { focus-window-down;  }
    Mod+Up             { focus-window-up;    }
    Mod+Shift+Left     { move-column-left;   }
    Mod+Shift+Right    { move-column-right;  }
    Mod+Shift+Down     { move-window-down;   }
    Mod+Shift+Up       { move-window-up;     }

    // ─── Workspaces ─────────────────────────────────────────────────────────
    Mod+1              { focus-workspace 1; }
    Mod+2              { focus-workspace 2; }
    Mod+3              { focus-workspace 3; }
    Mod+4              { focus-workspace 4; }
    Mod+5              { focus-workspace 5; }
    Mod+Shift+1        { move-column-to-workspace 1; }
    Mod+Shift+2        { move-column-to-workspace 2; }
    Mod+Shift+3        { move-column-to-workspace 3; }
    Mod+Shift+4        { move-column-to-workspace 4; }
    Mod+Shift+5        { move-column-to-workspace 5; }

    // ─── Column sizing ──────────────────────────────────────────────────────
    Mod+R              { switch-preset-column-width; }
    Mod+F              { maximize-column;     }
    Mod+Shift+F        { fullscreen-window;   }

    // ─── Closing ────────────────────────────────────────────────────────────
    Mod+Q              { close-window;        }
    Mod+Shift+E        { quit;                }

    // ─── Screenshots ────────────────────────────────────────────────────────
    Print              { screenshot;          }
    Mod+Print          { screenshot-screen;   }
    Mod+Shift+Print    { screenshot-window;   }

    // ─── Media + brightness via Noctalia IPC (was wpctl + brightnessctl) ────
    XF86AudioRaiseVolume   { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume   { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute          { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute       { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay          { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext          { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev          { spawn "noctalia" "msg" "media" "previous"; }
    XF86MonBrightnessUp    { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown  { spawn "noctalia" "msg" "brightness-down"; }
}
