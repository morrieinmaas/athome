{{- /* Side-hustle identity. Empty name/email falls back to personal
       (publishable template). SSH signing only when key exists. */ -}}
[user]
    name  = {{ .name_sidebiz  | default .name_personal }}
    email = {{ .email_sidebiz | default .email_personal }}
{{- $key := joinPath .chezmoi.homeDir ".ssh/sidebiz_ed25519.pub" }}
{{- if stat $key }}
    signingkey = {{ $key }}

[commit]
    gpgsign = true
[tag]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}
