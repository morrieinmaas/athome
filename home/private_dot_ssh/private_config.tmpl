# ~/.ssh/config — managed by chezmoi

Host *
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
# The ed25519 identity key is passphrase-less and pinned per-host via the
# IdentityFile below, so ssh reads it directly — no agent, no Keychain.

# ── GitHub ──────────────────────────────────────────────────────────────────
# ONE key per machine, named after the host ({{ .chezmoi.hostname }}_ed25519) so
# GitHub's key list shows which box each key is from and you can revoke a single
# machine cleanly. It does auth AND commit signing for your one GitHub account.
# Per-directory git *email* still varies (see ~/.gitconfig includeIf) — only the
# key is shared. If you ever add a second GitHub account, add a `Host
# github-<that-account>` alias here with its own IdentityFile.
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/{{ .chezmoi.hostname }}_ed25519
