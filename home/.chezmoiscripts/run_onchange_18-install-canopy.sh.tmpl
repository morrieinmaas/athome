#!/usr/bin/env bash
# Put canopy on this machine, and keep it current.
#
# canopy is a tmux configuration distribution: ~/.config/tmux/tmux.conf is a
# three-line stub that sources it, and ~/.config/canopy/user.conf holds what
# belongs to this machine. See https://github.com/morrieinmaas/canopy.
#
# Deliberately NOT `canopy install`. That command takes ownership of the tmux
# entry point and records a restore point for it, which is the right thing on
# a machine with no dotfile manager and the wrong thing here: chezmoi already
# owns that file, and two owners means every `chezmoi apply` silently reverts
# whichever wrote last. chezmoi owns the pointer, canopy owns what it points
# at. So this script only clones or updates the store and regenerates the
# files canopy generates.
#
# run_onchange, keyed on the pinned ref below: change the ref, and the next
# `chezmoi apply` moves the checkout. Nothing else re-runs it.
#
# canopy ref: {{ "v0.1.0" }}
set -euo pipefail

store="${HOME}/.local/share/canopy"
# SSH first, because this machine's other remotes are SSH, so the key is
# already the thing that works. HTTPS is the fallback for a machine with a
# credential helper and no key, and now that canopy is public it also works
# for a machine with neither. If neither reaches it, say so and leave: a
# dotfile apply should not fail over an optional tool, and the tmux entry
# point sources canopy with -q precisely so a machine without it still
# starts a usable tmux.
repo_ssh="git@github.com:morrieinmaas/canopy.git"
repo_https="https://github.com/morrieinmaas/canopy.git"
# A tag, not a branch, so a machine only moves when a release is cut rather
# than on whatever canopy's main happened to be that morning. Bumping it is
# two edits in one place: this line, and the `canopy ref:` comment above,
# which is what makes chezmoi re-run this script at all.
ref="v0.1.0"

if ! command -v git >/dev/null 2>&1; then
  printf 'canopy: git not found, skipping install\n' >&2
  exit 0
fi

if [ -d "${store}/.git" ]; then
  printf 'canopy: updating %s\n' "${store}"
  # --tags --force, because a tag is the thing being tracked and a moved tag
  # would otherwise be ignored by a fetch that already has one by that name.
  git -C "${store}" fetch --quiet --tags --force origin
  # A tag is not a branch, and the difference matters here: there is no
  # origin/<tag> to fast-forward onto, so the old `merge --ff-only
  # origin/${ref}` would fail on every apply and print the "has local
  # commits" warning at a machine that was perfectly healthy. Checking the
  # tag out detaches HEAD, which is correct for a store nothing should be
  # committing to.
  if git -C "${store}" rev-parse --quiet --verify "refs/tags/${ref}" >/dev/null 2>&1; then
    target="refs/tags/${ref}"
  else
    target="origin/${ref}"
  fi
  git -C "${store}" checkout --quiet --detach "${target}" || {
    printf 'canopy: could not move %s to %s; leaving it as it is\n' "${store}" "${ref}" >&2
  }
else
  printf 'canopy: cloning into %s\n' "${store}"
  mkdir -p "$(dirname "${store}")"
  if ! git clone --quiet --branch "${ref}" "${repo_ssh}" "${store}" 2>/dev/null; then
    if ! git clone --quiet --branch "${ref}" "${repo_https}" "${store}" 2>/dev/null; then
      printf 'canopy: could not clone over ssh or https, skipping\n' >&2
      printf '  clone it by hand into %s, then re-run: chezmoi apply\n' "${store}" >&2
      exit 0
    fi
  fi
fi

# The three generated files: capability flags, the command index, and the key
# layer. They live in ~/.local/state/canopy rather than in the checkout,
# because the store is read-only by convention and a generated file inside a
# git tree shows up as a local modification on every machine.
#
# Each is run from a bare environment on purpose. canopy resolves its own
# paths; exporting CANOPY_* here would hide a bug where it cannot.
for cmd in caps index keys; do
  if [ -x "${store}/bin/canopy-${cmd}" ]; then
    "${store}/bin/canopy-${cmd}" || printf 'canopy: canopy %s failed\n' "${cmd}" >&2
  fi
done

# Said rather than assumed: persistence needs both of these, and without
# either it does nothing at all while everything still looks healthy.
command -v bash >/dev/null 2>&1 ||
  printf 'canopy: bash not found, so the vendored plugins will not run: no autosave, no restore\n' >&2
ps -o ppid= -p $$ >/dev/null 2>&1 ||
  printf 'canopy: this ps cannot report a process parent, so no pane will be recognised as an agent\n' >&2

printf 'canopy: ready. `canopy doctor` reports what this machine can do.\n'

# What to do about a tmux server that is already running.
#
# chezmoi has just rewritten the config on disk, and a running server is
# still holding the old one. The two ways forward are not equivalent, and
# the difference is worth stating rather than leaving to be discovered.
#
# Re-sourcing into the running server picks up the new settings, but it
# does NOT undo what the old config already did. The old config loaded
# tmux-resurrect and tmux-continuum through TPM; canopy loads its own
# vendored copies. Re-sourcing leaves that server with both, which is two
# autosave loops writing one file. Fine for an hour, wrong to leave.
#
# A fresh server is the clean switch, and it is also the only way to see
# the restore path work, because continuum only arms its boot restore for
# a server that started within the last few seconds.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  printf '\n'
  printf 'canopy: a tmux server is already running, and it still holds the old config.\n'
  printf '  to try it here and now, in that server:\n'
  printf '      tmux source-file ~/.config/tmux/tmux.conf\n'
  printf '    this leaves resurrect and continuum loaded twice for the life of\n'
  printf '    that server, once from TPM and once from canopy. Do not leave it.\n'
  printf '  to switch properly, when the work in it can be let go:\n'
  printf '      tmux kill-server     # ends every session on this machine\n'
  printf '    then start tmux again. Check it with: canopy reboot-check\n'
  printf '\n'
  printf '  before killing anything, ask what would come back:\n'
  printf '      canopy reboot-check\n'
fi
