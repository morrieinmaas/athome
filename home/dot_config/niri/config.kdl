// ~/.config/niri/config.kdl — managed by chezmoi
// Tweak interactively with `nirimod` (live-validates and preserves comments).
// Validate manually: `niri validate -c ~/.config/niri/config.kdl`
//
// Shell: Noctalia (Quickshell). Authoritative IPC verb list lives at
//   https://github.com/noctalia-dev/noctalia-shell/blob/main/Services/Control/IPCService.qml
// Compositor recommendations from upstream:
//   https://docs.noctalia.dev/v4/getting-started/compositor-settings/niri/
//
// Anything Noctalia replaces natively (fuzzel/mako/swayidle/swaylock/polkit-
// gnome/cliphist/wpctl/brightnessctl direct calls) is NOT spawned/used here.

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:ctrl_modifier"
        }
        repeat-delay 250
        repeat-rate  35
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }

    mouse {
        accel-profile "flat"
    }

    // input{} children per niri source (lib.rs: focus_follows_mouse,
    // workspace_auto_back_and_forth).
    focus-follows-mouse
    workspace-auto-back-and-forth
}

// ThinkPad internal display. Run `niri msg outputs` to discover your real
// output name if eDP-1 doesn't match.
output "eDP-1" {
    mode "2560x1600@60.000"
    scale 1.25
    position x=0 y=0
}

layout {
    gaps 8
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color   "#cba6f7"
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color   "#cba6f7"
        inactive-color "#45475a"
    }

    insert-hint {
        color "#cba6f7"
    }
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }

// Noctalia is the official Noctalia recommendation — propagates these
// vars to its own subprocesses + matugen-themed apps.
environment {
    XDG_CURRENT_DESKTOP  "niri"
    QT_QPA_PLATFORM      "wayland"
    GDK_BACKEND          "wayland,x11"
    MOZ_ENABLE_WAYLAND   "1"
    XDG_SESSION_TYPE     "wayland"
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size  24
}

// ── spawn-at-startup ────────────────────────────────────────────────────────
// Noctalia is the *only* shell-thing we spawn. It internally provides
// the launcher (was fuzzel), notifications (was mako), lockscreen (was
// swaylock), idle handler (was swayidle), polkit agent (was polkit-
// gnome), clipboard history (was cliphist + wl-paste watchers), and
// wallpaper daemon (was swww-daemon). Adding any of those alongside
// Noctalia is duplicate work that fights over the same Wayland
// protocols / D-Bus names.
spawn-at-startup "qs" "-c" "noctalia-shell"

screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

// ── window rules ────────────────────────────────────────────────────────────
// Per docs.noctalia.dev/v4/getting-started/compositor-settings/niri/ —
// 20px corner radius is the Noctalia upstream recommendation; matches
// the panel/dock visuals.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Per Noctalia upstream: avoids spurious focus-snatch attempts from
// processes that didn't update their xdg-activation token correctly
// (the bar widget, system tray clicks, etc.).
debug {
    honor-xdg-activation-with-invalid-serial
}

// ── binds ───────────────────────────────────────────────────────────────────
// Noctalia IPC verbs verified against:
//   https://github.com/noctalia-dev/noctalia-shell/blob/main/Services/Control/IPCService.qml
// Discover full verb tree on-machine: `qs -c noctalia-shell ipc show`
binds {
    // Hotkey overlay (niri's own — shows everything below)
    Mod+Shift+Slash    { show-hotkey-overlay; }

    // ─── App launchers / spawn ──────────────────────────────────────────────
    Mod+Return         { spawn "ghostty"; }
    Mod+B              { spawn "zen-browser"; }
    // yazi is mise-managed; the niri session PATH lacks the mise shims, so
    // launch via an interactive login shell (sources path.zsh → shims on PATH).
    Mod+E              { spawn "ghostty" "-e" "zsh" "-ic" "yazi"; }

    // ─── Noctalia panels / launchers (via its IPC) ──────────────────────────
    // Generic launcher (Noctalia's, replaces fuzzel).
    Mod+Space          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    // Launcher in dedicated modes — much nicer than the cliphist+fuzzel chain.
    Ctrl+Alt+V         { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "clipboard"; }
    Ctrl+Alt+E         { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "emoji"; }
    Ctrl+Alt+W         { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "windows"; }
    // Control center + settings + bar peek (per Noctalia's recommended binds).
    Mod+S              { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+Comma          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "settings" "toggle"; }
    Mod+N              { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "notifications" "toggleHistory"; }
    Mod+Shift+T        { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "darkMode" "toggle"; }

    // ─── Lock / session ─────────────────────────────────────────────────────
    // Use Noctalia's native lockscreen IPC. systemd-logind compatibility
    // is preserved separately: loginctl lock-session is the standard
    // event Noctalia listens for too, so either path triggers the same
    // lockscreen.
    Mod+L              { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "lockScreen" "lock"; }

    // ─── Window focus / move ────────────────────────────────────────────────
    Mod+Left           { focus-column-left;  }
    Mod+Right          { focus-column-right; }
    Mod+Down           { focus-window-down;  }
    Mod+Up             { focus-window-up;    }
    Mod+Shift+Left     { move-column-left;   }
    Mod+Shift+Right    { move-column-right;  }
    Mod+Shift+Down     { move-window-down;   }
    Mod+Shift+Up       { move-window-up;     }

    // ─── Workspaces ─────────────────────────────────────────────────────────
    Mod+1              { focus-workspace 1; }
    Mod+2              { focus-workspace 2; }
    Mod+3              { focus-workspace 3; }
    Mod+4              { focus-workspace 4; }
    Mod+5              { focus-workspace 5; }
    Mod+Shift+1        { move-column-to-workspace 1; }
    Mod+Shift+2        { move-column-to-workspace 2; }
    Mod+Shift+3        { move-column-to-workspace 3; }
    Mod+Shift+4        { move-column-to-workspace 4; }
    Mod+Shift+5        { move-column-to-workspace 5; }

    // ─── Column sizing ──────────────────────────────────────────────────────
    Mod+R              { switch-preset-column-width; }
    Mod+F              { maximize-column;     }
    Mod+Shift+F        { fullscreen-window;   }

    // ─── Closing ────────────────────────────────────────────────────────────
    Mod+Q              { close-window;        }
    Mod+Shift+E        { quit;                }

    // ─── Screenshots ────────────────────────────────────────────────────────
    Print              { screenshot;          }
    Mod+Print          { screenshot-screen;   }
    Mod+Shift+Print    { screenshot-window;   }

    // ─── Media + brightness via Noctalia IPC (was wpctl + brightnessctl) ────
    XF86AudioRaiseVolume   { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "increase"; }
    XF86AudioLowerVolume   { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "decrease"; }
    XF86AudioMute          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteOutput"; }
    XF86AudioMicMute       { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "volume" "muteInput"; }
    XF86AudioPlay          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "playPause"; }
    XF86AudioNext          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "next"; }
    XF86AudioPrev          { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "media" "previous"; }
    XF86MonBrightnessUp    { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown  { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "brightness" "decrease"; }
}
