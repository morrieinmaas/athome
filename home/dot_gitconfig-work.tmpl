{{- /* Work identity. Empty name/email falls back to personal (publishable
       template — nothing real hardcoded). SSH signing only when key exists. */ -}}
[user]
    name  = {{ .name_work  | default .name_personal }}
    email = {{ .email_work | default .email_personal }}
{{- $key := joinPath .chezmoi.homeDir (printf ".ssh/%s_ed25519.pub" .chezmoi.hostname) }}
{{- if stat $key }}
    signingkey = {{ $key }}

[commit]
    gpgsign = true
[tag]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}
