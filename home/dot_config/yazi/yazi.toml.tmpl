# ~/.config/yazi/yazi.toml — managed by chezmoi
[mgr]
ratio          = [1, 4, 3]
sort_by        = "natural"
sort_sensitive = false
sort_reverse   = false
sort_dir_first = true
linemode       = "size"
show_hidden    = false
show_symlink   = true

[preview]
tab_size       = 2
max_width      = 600
max_height     = 900
image_filter   = "triangle"
image_quality  = 75
ueberzug_scale = 1
ueberzug_offset = [0, 0, 0, 0]

[opener]
edit       = [{ run = 'nvim "$@"', block = true }]
{{ if eq .chezmoi.os "darwin" -}}
open       = [{ run = 'open "$@"', desc = "Open" }]
reveal     = [{ run = 'open -R "$@"', desc = "Reveal" }]
{{- else -}}
open       = [{ run = 'xdg-open "$@"', desc = "Open" }]
reveal     = [{ run = 'xdg-open "$(dirname "$1")"', desc = "Reveal (open folder)" }]
{{- end }}

[open]
rules = [
  { mime = "text/*",  use = "edit" },
  { mime = "image/*", use = "open" },
  { mime = "*",       use = "open" },
]
