{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Enable the canopy-tmux user service (~/.config/systemd/user/canopy-tmux.service)
# so the tmux server, and with it canopy's session restore, starts with the
# desktop. Re-runs when the unit changes:
# unit hash = {{ include "dot_config/systemd/user/canopy-tmux.service.tmpl" | sha256sum }}
#
# The unit is not called tmux.service because tmux-continuum, with
# @continuum-boot off, runs `systemctl --user disable tmux.service`, which would
# switch our login unit off behind our back.
#
# Enable only, never --now: a tmux server is usually already running when you
# apply, and starting the unit then would add a stray session to it. It takes
# effect from the next login.
set -euo pipefail

if [ -n "${ATHOME_CI:-}" ]; then echo "ATHOME_CI: skipping headless setup ($(basename "$0"))"; exit 0; fi
command -v systemctl >/dev/null 2>&1 || exit 0

# Migrate from the old name. Only a tmux.service athome wrote (its managed
# header on line 1) is disabled and removed; any other tmux.service is left alone.
old="$HOME/.config/systemd/user/tmux.service"
if [ -f "$old" ] && case "$(head -n 1 "$old")" in "# ~/.config/systemd/user/tmux.service — managed by chezmoi"*) true ;; *) false ;; esac; then
  systemctl --user disable tmux.service >/dev/null 2>&1 || true
  rm -f "$old"
  echo "==> removed athome's old tmux.service (now canopy-tmux.service)"
fi

systemctl --user daemon-reload
if systemctl --user enable canopy-tmux.service >/dev/null 2>&1; then
  echo "==> canopy-tmux.service enabled: tmux (and your Claude panes) come back at next login"
else
  echo "!! couldn't enable canopy-tmux.service; enable it later with: systemctl --user enable canopy-tmux.service"
fi
{{ end -}}
