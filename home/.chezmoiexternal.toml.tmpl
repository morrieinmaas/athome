# Declarative externals fetched + refreshed by chezmoi itself.
# Beats run_once_ shell scripts: chezmoi handles update cadence, hash
# pinning, and clean uninstall (delete the entry, next apply removes).

# ── zinit (zsh plugin manager) ──────────────────────────────────────────────
# .zshrc also bootstraps zinit defensively on first launch — either path works.
[".local/share/zinit/zinit.git"]
    type          = "git-repo"
    url           = "https://github.com/zdharma-continuum/zinit.git"
    refreshPeriod = "168h"   # weekly

# ── TPM (tmux plugin manager) ───────────────────────────────────────────────
# tmux.conf also bootstraps TPM defensively. Plugins themselves are installed
# by .chezmoiscripts/run_onchange_after_14-install-tmux-plugins.sh on first apply.
[".config/tmux/plugins/tpm"]
    type          = "git-repo"
    url           = "https://github.com/tmux-plugins/tpm.git"
    refreshPeriod = "168h"

# bat's gruvbox-light / gruvbox-dark themes are built in (no external needed).
# bottom also ships gruvbox built-in. Nothing to fetch here.

