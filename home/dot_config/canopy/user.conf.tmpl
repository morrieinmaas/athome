# ~/.config/canopy/user.conf — managed by chezmoi.
#
# canopy sources this LAST, after every layer it ships, so anything set here
# wins. What lives here is what canopy cannot ship: keys that launch this
# machine's tools by absolute path, a status bar that calls this machine's
# scripts, and plugins canopy does not vendor.
#
# What LEFT this file when canopy took over, so it is not set twice:
#
#   prefix C-s, send-prefix           canopy 00-core + its key table
#   terminal-features, extended-keys  canopy 00-core
#   allow-passthrough, automatic-rename, allow-rename, set-clipboard,
#   mode-keys, escape-time, history-limit, mouse, renumber-windows,
#   base-index, pane-base-index       canopy 00-core
#   splits, cockpit layout, hjkl, HJKL, reload, session cycling
#                                     canopy's key table (tmux/keys.tsv)
#   @continuum-restore, @continuum-save-interval,
#   @resurrect-strategy-nvim          canopy 30-plugins
#   @resurrect-processes              canopy generates it from installed adapters
#   tmux-resurrect, tmux-continuum    canopy vendors both at pinned commits
#
# That last one matters most: leaving those two in the TPM list below would
# load them twice, which is two save loops writing one file and two restores
# racing at boot.

# --- what canopy does not set ----------------------------------------------

# The cockpit layout's left pane. canopy binds the layout (prefix c, prefix V)
# but takes no view on how wide it should be.
setw -g main-pane-width 50%

# --- this machine's keys ---------------------------------------------------
# Every one of these names a tool or a path that belongs to this machine, so
# none of them could ship in a distribution.
#
# The mise shims are called by ABSOLUTE path on purpose: display-popup runs
# its command in the tmux SERVER's environment, which never sourced a shell
# rc, so the shims dir is not on PATH there.

bind B run-shell '$HOME/.local/bin/cockpit'
bind g display-popup -E -w 95% -h 90% '$HOME/.config/themes/apply-ghdash.sh 2>/dev/null; exec $HOME/.local/share/mise/shims/gh-dash'
bind G display-popup -E -w 95% -h 90% -d '#{pane_current_path}' '$HOME/.config/tmux/enhance-pr.sh'
bind M new-window -n slack '$HOME/.config/themes/apply-slk.sh 2>/dev/null; exec $HOME/.local/share/mise/shims/slk'
bind N new-window -n mattermost '$HOME/.local/bin/matterhorn'
bind P display-popup -E -b none -w 60% -h 80% '$HOME/.config/tmux/pet-pick.sh'
bind T display-popup -E -b none -w 50% -h 55% 'THEME_POPUP=1 $HOME/.local/bin/theme'
bind W display-popup -E -b rounded -T " network " -w 66 -h 26 '$HOME/.config/tmux/net-popup.sh'
bind K run-shell '$HOME/.local/bin/tsess'

# prefix ? — searchable list of every binding, over the whole key table.
# canopy plans its own palette and which-key for M4 on prefix : and prefix ?,
# and this line will win over it until it is deliberately removed.
bind ? run-shell '$HOME/.config/tmux/keys-popup.sh'

# Click the network pills for detail. The else branch reproduces tmux's OWN
# default for this key with a two-line status, which is `switch-client -t =`,
# not select-window: get it wrong and clicking anywhere else on the status
# line silently stops working.
bind -n MouseDown1Status if -F '#{m:*net*,#{mouse_status_range}}' \
  'display-popup -E -b rounded -T " network " -w 66 -h 26 "$HOME/.config/tmux/net-popup.sh #{mouse_status_range}"' \
  'switch-client -t ='

# --- plugins canopy does not vendor ----------------------------------------
# resurrect and continuum are deliberately absent: canopy ships both, pinned
# by commit, and loads them before this file is read.
# How TPM finds these, which is not what it looks like. TPM does not read tmux
# OPTIONS to discover plugins; it GREPS config files for `@plugin` lines, and
# its search is one level deep: /etc/tmux.conf, ~/.config/tmux/tmux.conf, and
# the files that one sources DIRECTLY. This file is two levels away -- the stub
# sources canopy's tmux.conf, which sources this -- so `set -g @plugin` lines
# here are invisible and TPM loads nothing, silently, with exit status 0. The
# symptom is that every plugin key falls back to a tmux default (prefix s went
# back to choose-tree instead of sessionx).
#
# @tpm_plugins is TPM's older list form, and the one thing it DOES read from a
# real tmux option (`show-option -gqv @tpm_plugins`, first line of
# tpm_plugins_list_helper). An option survives being sourced from any depth,
# so this is the form to use under canopy. Keep the trailing backslashes: this
# is the continuation syntax TPM's own README documents.
set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.config/tmux/plugins/'

set -g @tpm_plugins '                        \
  tmux-plugins/tpm                           \
  tmux-plugins/tmux-sensible                 \
  tmux-plugins/tmux-yank                     \
  sainnhe/tmux-fzf                           \
  christoomey/vim-tmux-navigator             \
  omerxx/tmux-sessionx                       \
  alexwforsythe/tmux-which-key               \
  Ataraxy-Labs/opensessions                  \
  wfxr/tmux-fzf-url                          \
  craftzdog/tmux-claude-session-manager      \
'

set -g @fzf-url-history-limit '2000'
set -g @claude_launch_key 'a'
set -g @claude_list_key   'A'
set -g @sessionx-bind         's'
set -g @sessionx-zoxide-mode  'on'
set -g @sessionx-window-mode  'on'

if "test ! -d ~/.config/tmux/plugins/tpm" \
   "run 'git clone --depth 1 https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm \
        && ~/.config/tmux/plugins/tpm/bin/install_plugins'"

run '~/.config/tmux/plugins/tpm/tpm'

# Re-assert what plugins clobber at load. opensessions hard-binds prefix C-s
# to sidebar-focus, which takes the send-prefix binding canopy's key table
# declares; prefix o s still reaches the sidebar.
bind C-s send-prefix

# which-key rebuilds its menu after TPM re-sources it, so this has to wait
# for that rather than run inline.
run-shell -b '$HOME/.config/tmux/wk-keys-fix.sh'

# --- the status bar --------------------------------------------------------
# This machine's bar, kept whole. canopy ships its own in 20-status and this
# overrides it, which is the supported way round: canopy's colours come from
# the same @theme_* options the `theme` picker writes, so a theme still
# repaints everything either way.
#
# One line here is load bearing and easy to lose. tmux-continuum PREPENDS
# `#(continuum_save.sh)` to whatever status-right holds when it loads, and
# that interpolation IS the autosave: it fires on status redraws. Setting
# status-right here, after canopy's plugin layer, removes it, so the call is
# put back explicitly at the end of the line below, now pointing at canopy's
# vendored copy rather than the TPM one. `canopy doctor` checks for it.

set -g status 2
set -g status-format[1] ""
set -g status-justify left
set -g status-interval 5
set -g status-style "bg=default,fg=#{@theme_fg}"
set -g status-left-length  100
set -g status-right-length 200

set -g status-left "#[fg=#{@theme_grey},bg=default]#{@pill_l}#[fg=#{@theme_bg},bg=#{@theme_grey},bold] #h #[fg=#{@theme_grey},bg=default,nobold]#{@pill_r} #[fg=#{?client_prefix,#{@theme_red},#{@theme_blue}},bg=default]#{@pill_l}#[fg=#{@theme_bg},bg=#{?client_prefix,#{@theme_red},#{@theme_blue}},bold] #S #[fg=#{?client_prefix,#{@theme_red},#{@theme_blue}},bg=default,nobold]#{@pill_r}  "

set -g window-status-separator " "
set -g window-status-format "#[fg=#{@theme_muted},bg=default] #I#{?#W, #W,} "
set -g window-status-current-format "#[fg=#{@theme_yellow},bg=default]#{@pill_l}#[fg=#{@theme_fg},bg=#{@theme_yellow},bold] #I#{?#W, #W,}#{?window_zoomed_flag, #{@pill_zoom},} #[fg=#{@theme_yellow},bg=default,nobold]#{@pill_r}"

set -g @pet 'on'
set -g @batt 'on'
set -g @net 'on'
set -g status-right "#{?@pet,#[bg=default] #(~/.config/tmux/pet.sh)  ,}#{?@net,#[bg=default]#[range=user|net]#(~/.config/tmux/net.sh)#[norange]  ,}#{?@batt,#[bg=default]#(~/.config/tmux/battery.sh)  ,}#[fg=#{@theme_grey},bg=default]#{@pill_l}#[fg=#{@theme_fg},bg=#{@theme_grey}] %a %d %b #[fg=#{@theme_grey},bg=default]#{@pill_r}  #[fg=#{@theme_green},bg=default]#{@pill_l}#[fg=#{@theme_bg},bg=#{@theme_green},bold] %H:%M #[fg=#{@theme_green},bg=default,nobold]#{@pill_r} #({{ .chezmoi.homeDir }}/.local/share/canopy/plugins/tmux-continuum/scripts/continuum_save.sh)"

# Honour a theme picked in an earlier session, overriding the defaults
# canopy's 20-status sets.
if-shell '[ -r ~/.config/themes/active ]' 'run-shell "~/.config/themes/apply-tmux.sh"'
