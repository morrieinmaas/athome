; ~/.config/qt5ct/qt5ct.conf, written once by chezmoi (create_), then yours:
; qt5ct rewrites this file from its own settings window. Qt apps pick it up via
; QT_QPA_PLATFORMTHEME=qt5ct (niri environment block). The colour scheme is
; the one Noctalia's qt template writes from the shell palette.
[Appearance]
color_scheme_path={{ .chezmoi.homeDir }}/.config/qt5ct/colors/noctalia.conf
custom_palette=true
icon_theme=Papirus-Dark
standard_dialogs=default
style=Fusion
