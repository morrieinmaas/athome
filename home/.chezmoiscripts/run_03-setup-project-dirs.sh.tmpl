#!/usr/bin/env bash
# Pre-create per-context project directories + seed an .envrc that pins
# the matching rbw/Bitwarden context. Idempotent (mkdir -p, .envrc only
# written if missing — never clobbers user-customized envrc files).
#
# Personal machines (machineType = "personal") get:
#   ~/personal/    .envrc → `use ctx personal`
#   ~/sidebiz/     .envrc → `use ctx sidebiz`
#
# Work machines (machineType = "work") get:
#   ~/work/        .envrc → `use ctx work`
#
# Why no ~/Code anchor: a single tree per context makes wrong-credential
# accidents structurally hard. "Cloned a sidebiz repo into ~/Code/
# <handle>/ then committed with the personal email" can't happen
# anymore — the directory IS the context.
#
# direnv.toml whitelists these prefixes, so .envrc files load on `cd`
# without needing `direnv allow` per repo. Subdirectories inherit
# unless they ship their own .envrc.
#
# Cross-platform: runs on macOS AND Linux. The smug/cockpit configs, the
# work/pers/side aliases, and the repo() function all reference these dirs
# unconditionally, so both OSes need them (the old "Linux-only, fold dirs in
# by hand on macOS" gate left a personal Mac with no project dirs at all).
# PLAIN run_ (every apply), not run_once_: idempotent + self-healing — it
# recreates a dir you deleted and applies on a machine where the prior
# run_once_ was already recorded "done" and would otherwise never re-run.
set -euo pipefail

seed_envrc() {
  local dir="$1" ctx="$2"
  mkdir -p "$dir"
  local envrc="$dir/.envrc"
  if [[ -f "$envrc" ]]; then
    return  # don't clobber user's customization
  fi
  cat > "$envrc" <<EOF
# Auto-seeded by chezmoi (run_03-setup-project-dirs.sh.tmpl).
# Bundles the right rbw/Bitwarden context for anything under $dir/ —
# subdirectories inherit unless they override with their own .envrc.
use ctx $ctx
EOF
  echo "✓ seeded $envrc"
}

{{ if eq .machineType "personal" -}}
seed_envrc "$HOME/personal" personal
seed_envrc "$HOME/sidebiz"  sidebiz
{{- else if eq .machineType "work" -}}
seed_envrc "$HOME/work"     work
{{- end }}
